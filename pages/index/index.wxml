<view class="page" wx:if="{{pageReady}}">
  <view class="header">
    <view class="header-top">
      <view>
        <view class="page-hint eyebrow">COLLECTION JOURNAL</view>
        <view class="page-title">月亮手杖</view>
        <view class="subtitle">保存小卡、票根和周边，做成你的手帐</view>
      </view>
      <view class="header-actions">
        <view class="btn btn-icon" bindtap="onTapCreate" hover-class="action-hover">
          <text class="icon-add">+</text>
        </view>
      </view>
    </view>
    <view class="dashed-divider"></view>
  </view>

  <view class="continue-card" wx:if="{{lastEditedBook}}" bindtap="onTapContinue">
    <view class="continue-left">
      <view class="continue-label">继续编辑</view>
      <view class="continue-name">{{lastEditedBook.name}}</view>
      <view class="continue-meta">{{lastEditedBook.pageCount}} 页 · {{lastEditedBook.timeAgo}}</view>
    </view>
    <view class="continue-arrow">›</view>
  </view>

  <view class="export-card" wx:if="{{exporting}}">
    <view class="export-left">
      <view class="export-label">正在导出…</view>
      <view class="export-name">{{exportStatus}}</view>
      <view class="export-progress" wx:if="{{exportTotal > 0}}">第 {{exportProgress}} / {{exportTotal}} 页</view>
    </view>
    <view class="export-spinner">
      <view class="spin-ring"></view>
    </view>
  </view>

  <scroll-view scroll-y class="book-list" enhanced show-scrollbar="{{false}}">
    <view class="book-grid">
      <view
        class="book-card"
        wx:for="{{books}}"
        wx:key="id"
        bindtap="onTapBook"
        data-id="{{item.id}}"
        bindlongpress="onLongPressBook"
      >
        <view class="book-cover" style="background: linear-gradient(135deg, {{item.themeInfo.primary}}22, {{item.themeInfo.secondary}}22);">
          <image wx:if="{{item.coverImage}}" class="cover-image" src="{{item.coverImage}}" mode="aspectFill" />
          <block wx:else>
            <view class="cover-line-art">
              <view class="cover-spine"></view>
              <view class="cover-page-line line-a"></view>
              <view class="cover-page-line line-b"></view>
              <view class="cover-page-line line-c"></view>
            </view>
          </block>
        </view>
        <view class="book-info">
          <view class="book-name">{{item.name}}</view>
          <view class="book-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <text class="book-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
          <view class="book-meta">
            <text class="book-pages">{{item.pageCount}} 页</text>
            <text class="book-time code-chip">{{item.themeInfo.name}}</text>
          </view>
        </view>
        <view class="book-edit-btn" catchtap="onTapEditBook" data-id="{{item.id}}">
          <view class="line-more"></view>
        </view>
      </view>

    </view>
    <view style="height: 120rpx;"></view>
  </scroll-view>

  <view class="modal-mask create-journal-mask" wx:if="{{showCreateModal}}">
    <view class="modal create-journal-screen" catchtap="stopPropagation" style="{{keyboardHeight > 0 ? 'padding-bottom:' + keyboardHeight + 'px;' : ''}}">
      <view class="create-journal-topbar">
        <view class="create-journal-icon-btn" bindtap="onCancelCreate" hover-class="soft-hover" aria-label="close">
          <image src="/assets/icons/x.svg" mode="aspectFit" />
        </view>
        <view class="create-journal-heading">
          <text class="create-journal-kicker">NEW JOURNAL</text>
          <text class="create-journal-title">新建手账本</text>
        </view>
        <view class="create-journal-submit" bindtap="onConfirmCreate" hover-class="soft-hover">创建</view>
      </view>
      <view class="modal-header">
        <view class="eyebrow">NEW JOURNAL</view>
        <view class="modal-title">新建手帐本</view>
      </view>
      <view class="modal-body">
        <view class="input-group">
          <text class="input-label">名称</text>
          <input
            class="input"
            placeholder="给手帐本起个名字"
            placeholder-class="input-placeholder"
            value="{{newBookName}}"
            bindinput="onInputName"
            focus="{{showCreateModal}}"
            maxlength="20"
          />
        </view>
        <view class="input-group">
          <text class="input-label">主题风格</text>
          <scroll-view scroll-x class="theme-scroll" enhanced show-scrollbar="{{false}}">
            <view class="theme-list">
              <view
                class="theme-item {{selectedTheme === item.key ? 'active' : ''}}"
                wx:for="{{themeList}}"
                wx:key="key"
                bindtap="onSelectTheme"
                data-key="{{item.key}}"
              >
                <view class="theme-swatch" style="background: linear-gradient(135deg, {{item.primary}}, {{item.secondary}});"></view>
                <text class="theme-name">{{item.name}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
        <view class="input-group">
          <text class="input-label">封面图片</text>
          <view class="cover-picker" bindtap="onCreateChooseCover">
            <image wx:if="{{creatingCoverImage}}" class="cover-preview" src="{{creatingCoverImage}}" mode="aspectFill" />
            <view wx:else class="cover-placeholder">
              <text>点击选择封面</text>
            </view>
          </view>
        </view>
        <view class="input-group">
          <text class="input-label">标签</text>
          <view class="tags-editor">
            <view class="tag-chip" wx:for="{{creatingTags}}" wx:key="*this">
              <text>{{item}}</text>
              <text class="tag-remove" catchtap="onCreateRemoveTag" data-index="{{index}}">×</text>
            </view>
            <input class="tag-input" placeholder="输入标签回车添加" placeholder-class="input-placeholder" value="{{newCreateTagInput}}" bindinput="onCreateTagInput" bindconfirm="onCreateAddTag" />
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn btn-secondary modal-btn" bindtap="onCancelCreate">取消</view>
        <view class="btn btn-primary modal-btn" bindtap="onConfirmCreate">创建</view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCancelEdit">
    <view class="modal" catchtap="stopPropagation" style="{{keyboardHeight > 0 ? 'padding-bottom:' + keyboardHeight + 'px;' : ''}}">
      <view class="modal-header">
        <view class="eyebrow">EDIT JOURNAL</view>
        <view class="modal-title">编辑手帐本</view>
      </view>
      <view class="modal-body">
        <view class="input-group">
          <text class="input-label">名称</text>
          <input
            class="input"
            placeholder="手帐本名称"
            placeholder-class="input-placeholder"
            value="{{newBookName}}"
            bindinput="onInputName"
            maxlength="20"
          />
        </view>
        <view class="input-group">
          <text class="input-label">封面图片</text>
          <view class="cover-picker" bindtap="onChooseCover">
            <image wx:if="{{editingCoverImage}}" class="cover-preview" src="{{editingCoverImage}}" mode="aspectFill" />
            <view wx:else class="cover-placeholder">
              <text>点击选择封面</text>
            </view>
          </view>
        </view>
        <view class="input-group">
          <text class="input-label">标签</text>
          <view class="tags-editor">
            <view class="tag-chip" wx:for="{{editingTags}}" wx:key="*this">
              <text>{{item}}</text>
              <text class="tag-remove" catchtap="onRemoveTag" data-index="{{index}}">×</text>
            </view>
            <input class="tag-input" placeholder="输入标签回车添加" placeholder-class="input-placeholder" value="{{newTagInput}}" bindinput="onTagInput" bindconfirm="onAddTag" />
          </view>
        </view>
        <view class="input-group">
          <text class="input-label">主题风格</text>
          <scroll-view scroll-x class="theme-scroll" enhanced show-scrollbar="{{false}}">
            <view class="theme-list">
              <view
                class="theme-item {{selectedTheme === item.key ? 'active' : ''}}"
                wx:for="{{themeList}}"
                wx:key="key"
                bindtap="onSelectTheme"
                data-key="{{item.key}}"
              >
                <view class="theme-swatch" style="background: linear-gradient(135deg, {{item.primary}}, {{item.secondary}});"></view>
                <text class="theme-name">{{item.name}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn btn-secondary modal-btn" bindtap="onCancelEdit">取消</view>
        <view class="btn btn-primary modal-btn" bindtap="onConfirmEdit">保存</view>
      </view>
    </view>
  </view>
</view>
