<view class="editor-page {{editorMode === 'preview' ? 'preview-mode' : 'edit-mode'}}">
  <view class="top-bar">
    <view class="top-left">
      <view class="icon-btn back-btn" bindtap="onTapBack" hover-class="soft-hover" hover-stay-time="80" aria-label="返回">
        <image class="ui-icon" src="/assets/icons/arrow-left.svg" mode="aspectFit" />
      </view>
      <view class="page-info">
        <view class="page-name">{{bookName}}</view>
        <view class="page-hint">{{editorMode === 'preview' ? '预览翻页' : '画布编辑'}}</view>
      </view>
    </view>

    <view class="top-page-nav" wx:if="{{bookPages.length > 0}}">
      <view class="top-page-btn {{currentPageIndex <= 0 ? 'disabled' : ''}}" bindtap="onTapPrevPage" hover-class="soft-hover" aria-label="previous page">
        <image class="ui-icon" src="/assets/icons/chevron-left.svg" mode="aspectFit" />
      </view>
      <view class="top-page-count">{{currentPageIndex + 1}} / {{bookPages.length}}</view>
      <view class="top-page-btn {{currentPageIndex >= bookPages.length - 1 ? 'disabled' : ''}}" bindtap="onTapNextPage" hover-class="soft-hover" aria-label="next page">
        <image class="ui-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="top-right">
      <view class="icon-btn {{!canUndo ? 'disabled' : ''}}" bindtap="onTapAction" data-action="undo" hover-class="soft-hover" hover-stay-time="80" aria-label="撤销">
        <image class="ui-icon" src="/assets/icons/undo.svg" mode="aspectFit" />
      </view>
      <view class="icon-btn {{!canRedo ? 'disabled' : ''}}" bindtap="onTapAction" data-action="redo" hover-class="soft-hover" hover-stay-time="80" aria-label="重做">
        <image class="ui-icon" src="/assets/icons/redo.svg" mode="aspectFit" />
      </view>
      <view class="icon-btn" bindtap="onTapAction" data-action="export" hover-class="soft-hover" hover-stay-time="80" aria-label="export page">
        <image class="ui-icon" src="/assets/icons/download.svg" mode="aspectFit" />
      </view>
      <view class="mode-toggle {{editorMode === 'preview' ? 'active' : ''}}" bindtap="toggleEditorMode" hover-class="soft-hover" hover-stay-time="80" aria-label="toggle preview">
        <image class="ui-icon" src="{{editorMode === 'preview' ? '/assets/icons/edit-3.svg' : '/assets/icons/book-open.svg'}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="canvas-wrapper" bindtap="closeAllPanels">
    <view class="page-shell">
      <view class="canvas-container paper-canvas" style="width: {{pageDisplayWidth}}rpx; height: {{pageDisplayHeight}}rpx;">
        <canvas
          id="editorCanvas"
          type="2d"
          class="editor-canvas"
          style="width: {{pageDisplayWidth}}rpx; height: {{pageDisplayHeight}}rpx;"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          disable-scroll
        ></canvas>
      </view>
    </view>
  </view>

  <view class="selection-toolbar" wx:if="{{selectedId && editorMode === 'edit'}}" style="{{toolbarStyle}}">
    <view class="toolbar-drag-handle" bindtouchstart="onToolbarDragStart" catchtouchmove="onToolbarDragMove" bindtouchend="onToolbarDragEnd">
      <image class="grip-icon" src="/assets/icons/grip-dots.svg" mode="aspectFit" />
    </view>
    <view class="sel-btn" bindtap="duplicateSelected" hover-class="soft-hover" hover-stay-time="80" data-tooltip="复制">
      <image class="ui-icon" src="/assets/icons/copy.svg" mode="aspectFit" />
    </view>
    <view class="sel-btn {{selectedElement.effect === 'paper' ? 'active' : ''}} {{selectedElement.locked ? 'disabled' : ''}}" wx:if="{{selectedElement.type === 'image'}}" bindtap="setSelectedEffect" data-effect="{{selectedElement.effect === 'paper' ? 'none' : 'paper'}}" hover-class="soft-hover" hover-stay-time="80" data-tooltip="纸边">
      <image class="ui-icon" src="/assets/icons/file-text.svg" mode="aspectFit" />
    </view>
    <view class="sel-btn" wx:if="{{selectedElement.type === 'text'}}" bindtap="openSelectedTextEditor" hover-class="soft-hover" hover-stay-time="80" data-tooltip="编辑">
      <image class="ui-icon" src="/assets/icons/type.svg" mode="aspectFit" />
    </view>
    <view class="sel-btn" wx:if="{{selectedElement.type === 'decoration' && selectedElement.fillImage}}" bindtap="showFillImagePositionPanel" hover-class="soft-hover" hover-stay-time="80" data-tooltip="移动图片">
      <image class="ui-icon" src="/assets/icons/move.svg" mode="aspectFit" />
    </view>
    <view class="sel-btn" wx:if="{{selectedElement.type === 'image' && selectedElement.cropMode === 'cover'}}" bindtap="cropSelectedImage" hover-class="soft-hover" hover-stay-time="80" data-tooltip="调整裁切">
      <image class="ui-icon" src="/assets/icons/move.svg" mode="aspectFit" />
    </view>
    <view class="sel-btn {{selectedElement.locked ? 'active' : ''}}" bindtap="toggleSelectedLock" hover-class="soft-hover" hover-stay-time="80" data-tooltip="{{selectedElement.locked ? '解锁' : '锁定'}}">
      <image class="ui-icon" src="{{selectedElement.locked ? '/assets/icons/unlock.svg' : '/assets/icons/lock.svg'}}" mode="aspectFit" />
    </view>
    <view class="sel-btn danger {{selectedElement.locked ? 'disabled' : ''}}" bindtap="deleteSelected" hover-class="soft-hover" hover-stay-time="80" data-tooltip="删除">
      <image class="ui-icon" src="/assets/icons/trash-2.svg" mode="aspectFit" />
    </view>
    <view class="sel-btn" bindtap="openSelectedMoreMenu" hover-class="soft-hover" hover-stay-time="80" data-tooltip="更多">
      <image class="ui-icon" src="/assets/icons/more-horizontal.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="selected-more-mask {{showSelectedMorePanel ? 'show' : ''}}" bindtap="closeSelectedMorePanel"></view>
  <view class="selected-more-sheet {{showSelectedMorePanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="selected-more-header">
      <text>{{selectedMoreTitle}}</text>
      <view class="selected-more-close" bindtap="closeSelectedMorePanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="selected-more-grid">
      <view
        class="selected-more-item"
        wx:for="{{selectedMoreActions}}"
        wx:key="key"
        bindtap="onSelectedMoreAction"
        data-action="{{item.key}}"
        hover-class="soft-hover"
        hover-stay-time="80"
      >
        <image class="selected-more-icon" src="{{item.icon}}" mode="aspectFit" />
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="page-dots-bar edit-page-nav" wx:if="{{bookPages.length > 0 && editorMode === 'edit'}}">
    <view class="page-nav-controls">
      <view class="page-nav-btn page-nav-add" bindtap="addNewPage" hover-class="soft-hover" hover-stay-time="80" aria-label="添加页面">
        <image class="ui-icon" src="/assets/icons/plus.svg" mode="aspectFit" />
      </view>
      <view class="page-nav-btn page-nav-delete {{bookPages.length <= 1 || isCoverPage ? 'disabled' : ''}}" bindtap="deleteCurrentPage" hover-class="soft-hover" hover-stay-time="80" aria-label="删除页面">
        <image class="ui-icon" src="/assets/icons/trash-2.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="page-dots-bar preview-page-nav" wx:if="{{bookPages.length > 0 && editorMode === 'preview'}}">
    <scroll-view scroll-x class="dots-scroll" enhanced show-scrollbar="{{false}}">
      <view class="dots-row">
        <view
          class="page-dot {{currentPageIndex === index ? 'active' : ''}}"
          wx:for="{{bookPages}}"
          wx:key="id"
          bindtap="onTapPageDot"
          data-index="{{index}}"
          hover-class="soft-hover-scale"
          hover-stay-time="80"
          aria-label="跳转到第 {{index + 1}} 页"
        >
          {{index + 1}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="floating-tool-dock" wx:if="{{editorMode === 'edit'}}" style="{{toolDockTopStyle}}">
    <view class="tool-btn {{showStickerPanel ? 'active' : ''}}" bindtap="toggleStickerPanel" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/sticker.svg" mode="aspectFit" />
      <text>素材</text>
    </view>
    <view class="tool-btn {{showDrawPanel ? 'active' : ''}}" bindtap="toggleDrawPanel" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/pencil-line.svg" mode="aspectFit" />
      <text>手绘</text>
    </view>
    <view class="tool-btn {{showTextPanel ? 'active' : ''}}" bindtap="toggleTextPanel" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/type.svg" mode="aspectFit" />
      <text>文字</text>
    </view>
    <view class="tool-btn {{showRectPanel ? 'active' : ''}}" bindtap="toggleRectPanel" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/square.svg" mode="aspectFit" />
      <text>矩形</text>
    </view>
    <view class="tool-btn" bindtap="addFromAlbum" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/image.svg" mode="aspectFit" />
      <text>图片</text>
    </view>
    <view class="tool-btn" bindtap="addFromCamera" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/camera.svg" mode="aspectFit" />
      <text>拍照</text>
    </view>
    <view class="tool-btn {{showBgPanel ? 'active' : ''}}" bindtap="toggleBgPanel" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/palette.svg" mode="aspectFit" />
      <text>背景</text>
    </view>
    <view class="tool-btn {{showTemplatePanel ? 'active' : ''}}" bindtap="toggleTemplatePanel" hover-class="soft-hover" hover-stay-time="80">
      <image class="ui-icon" src="/assets/icons/layout-template.svg" mode="aspectFit" />
      <text>模板</text>
    </view>
  </view>

  <view class="panel {{showStickerPanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="panel-header">
      <text class="panel-title">素材库</text>
      <view class="panel-search-bar">
        <input class="panel-search-input" placeholder="搜索素材..." placeholder-class="search-placeholder" value="{{panelSearchKeyword}}" bindinput="onPanelSearchInput" />
      </view>
      <view class="panel-close" bindtap="toggleStickerPanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <scroll-view scroll-y class="panel-scroll">
      <!-- 分组 -->
      <view class="panel-categories" wx:if="{{panelCategories.length > 0}}">
        <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="{{false}}">
          <view class="category-list">
            <view class="category-tag {{panelActiveCategory === item.key ? 'active' : ''}}" wx:for="{{panelCategories}}" wx:key="key" bindtap="onPanelCategoryTap" data-key="{{item.key}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
      <!-- 当下组件 -->
      <view class="widget-section" wx:if="{{panelActiveCategory === 'all'}}">
        <view class="panel-eyebrow">当下</view>
        <scroll-view scroll-x class="widget-scroll" enhanced show-scrollbar="{{false}}">
          <view class="widget-list">
            <view class="widget-card" wx:for="{{nowWidgets}}" wx:key="type" bindtap="onTapNowWidget" data-type="{{item.type}}" hover-class="soft-hover" hover-stay-time="80">
              <view class="widget-icon">{{item.icon}}</view>
              <view class="widget-label">{{item.label}}</view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="sticker-grid" wx:if="{{stickers.length > 0}}">
        <view class="sticker-item user-sticker" wx:for="{{stickers}}" wx:key="id" bindtap="addUserSticker" data-id="{{item.id}}" data-src="{{item.src}}" hover-class="soft-hover" hover-stay-time="80">
          <image src="{{item.src}}" mode="aspectFit" class="sticker-img" />
        </view>
      </view>
      <view class="empty-stickers" wx:else>
        <text class="empty-title">还没有贴纸</text>
        <text class="empty-hint">从“提取”页生成素材，或直接添加图片到画布。</text>
      </view>
    </scroll-view>
  </view>

  <view class="draw-workspace {{showDrawPanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="draw-topbar">
      <view class="draw-top-btn" bindtap="toggleDrawPanel" hover-class="soft-hover" aria-label="close drawing">
        <image class="draw-tool-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
      <view class="draw-title-wrap">
        <text class="draw-title">手绘</text>
      </view>
      <view class="draw-top-actions">
        <view class="draw-ghost-btn {{!drawCanUndo ? 'disabled' : ''}}" bindtap="undoDrawSticker" hover-class="soft-hover" aria-label="undo">
          <image class="draw-tool-icon" src="/assets/icons/undo.svg" mode="aspectFit" />
        </view>
        <view class="draw-ghost-btn {{!drawCanRedo ? 'disabled' : ''}}" bindtap="redoDrawSticker" hover-class="soft-hover" aria-label="redo">
          <image class="draw-tool-icon" src="/assets/icons/redo.svg" mode="aspectFit" />
        </view>
        <view class="draw-save-btn {{!drawHasContent ? 'disabled' : ''}}" bindtap="saveDrawSticker" hover-class="soft-hover">完成</view>
      </view>
    </view>

    <view class="draw-board">
      <canvas type="2d" id="drawStickerCanvas" class="draw-sticker-canvas" disable-scroll="{{true}}" bindtouchstart="onDrawStickerStart" bindtouchmove="onDrawStickerMove" bindtouchend="onDrawStickerEnd" />
      <view class="draw-empty-hint" wx:if="{{!drawHasContent}}"><text>在画布上开始创作</text></view>
    </view>

    <view class="draw-side-toolbar">
      <view class="draw-icon-tool {{drawTool === 'pen' ? 'active' : ''}}" bindtap="onDrawToolSelect" data-tool="pen" aria-label="pen"><image src="/assets/icons/pencil-line.svg" mode="aspectFit" /></view>
      <view class="draw-icon-tool {{drawTool === 'curve' ? 'active' : ''}}" bindtap="onDrawToolSelect" data-tool="curve" aria-label="curve"><image src="/assets/icons/spline.svg" mode="aspectFit" /></view>
      <view class="draw-icon-tool {{drawTool === 'line' ? 'active' : ''}}" bindtap="onDrawToolSelect" data-tool="line" aria-label="line"><image src="/assets/icons/minus.svg" mode="aspectFit" /></view>
      <view class="draw-icon-tool {{drawTool === 'rect' ? 'active' : ''}}" bindtap="onDrawToolSelect" data-tool="rect" aria-label="rectangle"><image src="/assets/icons/square.svg" mode="aspectFit" /></view>
      <view class="draw-icon-tool {{drawTool === 'bucket' ? 'active' : ''}}" bindtap="onDrawToolSelect" data-tool="bucket" aria-label="paint bucket"><image src="/assets/icons/paint-bucket.svg" mode="aspectFit" /></view>
      <view class="draw-icon-tool {{drawTool === 'eraser' ? 'active' : ''}}" bindtap="onDrawToolSelect" data-tool="eraser" aria-label="eraser"><image src="/assets/icons/eraser.svg" mode="aspectFit" /></view>
      <view class="draw-icon-tool draw-color-tool {{showDrawColorPanel ? 'active' : ''}}" bindtap="toggleDrawColorPanel" aria-label="color"><view class="draw-current-color" style="background: {{drawColor}};"></view></view>
      <view class="draw-icon-tool {{showDrawLayerPanel ? 'active' : ''}}" bindtap="toggleDrawLayerPanel" aria-label="layers"><image src="/assets/icons/layers.svg" mode="aspectFit" /></view>
    </view>

    <view class="draw-parameter-stack">
      <view class="draw-vertical-control">
        <image src="/assets/icons/minus.svg" mode="aspectFit" />
        <slider class="draw-vertical-slider" min="1" max="40" value="{{drawWidth}}" bindchanging="onDrawWidthSlider" bindchange="onDrawWidthSlider" activeColor="#d98eaa" backgroundColor="#eadccf" block-color="#fffdf8" block-size="18" />
      </view>
      <view class="draw-vertical-control">
        <image src="/assets/icons/droplet.svg" mode="aspectFit" />
        <slider class="draw-vertical-slider" min="5" max="100" value="{{drawOpacity}}" bindchanging="onDrawOpacitySlider" bindchange="onDrawOpacitySlider" activeColor="#a8dcc9" backgroundColor="#eadccf" block-color="#fffdf8" block-size="18" />
      </view>
    </view>

    <view class="draw-popover draw-color-popover {{showDrawColorPanel ? 'show' : ''}}">
      <view class="draw-color-list">
        <view class="draw-color-item {{drawColor === item ? 'active' : ''}}" wx:for="{{drawColors}}" wx:key="*this" style="background: {{item}};" bindtap="onDrawColor" data-color="{{item}}"></view>
        <view class="draw-color-item draw-custom-color" bindtap="openDrawColorPicker" aria-label="custom color"><image src="/assets/icons/plus.svg" mode="aspectFit" /></view>
      </view>
    </view>

    <view class="draw-layer-panel {{showDrawLayerPanel ? 'show' : ''}}">
      <view class="draw-layer-header">
        <image src="/assets/icons/layers.svg" mode="aspectFit" />
        <view class="draw-layer-add" bindtap="addDrawLayer"><image src="/assets/icons/plus.svg" mode="aspectFit" /></view>
      </view>
      <view class="draw-layer-row {{drawActiveLayerId === item.id ? 'active' : ''}}" wx:for="{{drawLayers}}" wx:key="id" bindtap="selectDrawLayer" data-id="{{item.id}}">
        <view class="draw-layer-dot"></view>
        <text>{{index + 1}}</text>
        <view class="draw-layer-delete" wx:if="{{drawLayers.length > 1}}" catchtap="deleteDrawLayer" data-id="{{item.id}}"><image src="/assets/icons/trash-2.svg" mode="aspectFit" /></view>
      </view>
    </view>
  </view>

  <view class="panel {{showTextPanel ? 'show' : ''}}" catchtap="stopPropagation" style="{{showTextPanel && keyboardHeight > 0 ? 'padding-bottom:' + keyboardHeight + 'px;' : ''}}">
    <view class="panel-header">
      <text class="panel-title">{{textPanelMode === 'edit' ? '编辑文字' : textPanelMode === 'rect' ? '矩形文字' : textPanelMode === 'location' ? '添加地点' : '添加文字'}}</text>
      <view class="panel-close" bindtap="toggleTextPanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="panel-body">
      <textarea class="text-input" placeholder="{{textPanelMode === 'location' ? '输入地点名称...' : '输入文字内容'}}" placeholder-class="input-placeholder" value="{{textInput}}" bindinput="onTextInput" maxlength="200" auto-height />

      <text class="eyebrow">字体</text>
      <view class="font-list">
        <view class="font-item {{textFontFamily === item.key ? 'active' : ''}}" wx:for="{{textFonts}}" wx:key="key" bindtap="onTextFont" data-font="{{item.key}}" style="font-family: {{item.family}};">
          {{item.name}}
        </view>
      </view>

      <text class="eyebrow">颜色</text>
      <scroll-view scroll-x class="color-scroll" enhanced show-scrollbar="{{false}}">
        <view class="color-list">
          <block wx:for="{{textColors}}" wx:key="*this">
            <view wx:if="{{item === 'picker'}}" class="color-item color-picker-btn" bindtap="onTextColor" data-color="picker">
              <text class="picker-icon">+</text>
            </view>
            <view wx:else class="color-item {{textColor === item ? 'active' : ''}}" style="background: {{item}};" bindtap="onTextColor" data-color="{{item}}"></view>
          </block>
        </view>
      </scroll-view>

      <view class="text-component-actions" wx:if="{{textPanelMode === 'add'}}">
        <view class="text-component-btn" bindtap="addTodoComponent">
          <image src="/assets/icons/list-checks.svg" mode="aspectFit" />
          <text>Todo</text>
        </view>
        <view class="text-component-btn" bindtap="addProgressComponent">
          <image src="/assets/icons/chart-no-axes-column-increasing.svg" mode="aspectFit" />
          <text>进度条</text>
        </view>
      </view>
      <view class="btn btn-primary" bindtap="addText">{{textPanelMode === 'location' ? '添加地点' : textPanelMode === 'add' ? '添加到画布' : '保存文字'}}</view>
    </view>
  </view>

  <!-- 矩形面板 -->
  <view class="panel {{showRectPanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="panel-header">
      <text class="panel-title">添加矩形</text>
      <view class="panel-close" bindtap="toggleRectPanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="panel-body">
      <text class="eyebrow">形状</text>
      <view class="rect-shape-list">
        <view class="rect-shape-item {{rectShape === 'rect' ? 'active' : ''}}" bindtap="onRectShape" data-shape="rect">
          <view class="shape-preview shape-rect"></view>
          <text>矩形</text>
        </view>
        <view class="rect-shape-item {{rectShape === 'roundRect' ? 'active' : ''}}" bindtap="onRectShape" data-shape="roundRect">
          <view class="shape-preview shape-roundrect"></view>
          <text>圆角</text>
        </view>
        <view class="rect-shape-item {{rectShape === 'circle' ? 'active' : ''}}" bindtap="onRectShape" data-shape="circle">
          <view class="shape-preview shape-circle"></view>
          <text>圆形</text>
        </view>
        <view class="rect-shape-item {{rectShape === 'ellipse' ? 'active' : ''}}" bindtap="onRectShape" data-shape="ellipse">
          <view class="shape-preview shape-ellipse"></view>
          <text>椭圆</text>
        </view>
        <view class="rect-shape-item {{rectShape === 'line' ? 'active' : ''}}" bindtap="onRectShape" data-shape="line">
          <view class="shape-preview shape-line"></view>
          <text>直线</text>
        </view>
        <view class="rect-shape-item {{rectShape === 'curve' ? 'active' : ''}}" bindtap="onRectShape" data-shape="curve">
          <view class="shape-preview shape-curve"></view>
          <text>曲线</text>
        </view>
      </view>

      <text class="eyebrow">线条样式</text>
      <view class="rect-line-list">
        <view class="rect-line-item {{rectLineStyle === 'solid' ? 'active' : ''}}" bindtap="onRectLineStyle" data-style="solid">
          <view class="line-preview line-solid"></view>
          <text>实线</text>
        </view>
        <view class="rect-line-item {{rectLineStyle === 'dashed' ? 'active' : ''}}" bindtap="onRectLineStyle" data-style="dashed">
          <view class="line-preview line-dashed"></view>
          <text>虚线</text>
        </view>
        <view class="rect-line-item {{rectLineStyle === 'dotted' ? 'active' : ''}}" bindtap="onRectLineStyle" data-style="dotted">
          <view class="line-preview line-dotted"></view>
          <text>点线</text>
        </view>
      </view>

      <text class="eyebrow">线条粗细</text>
      <view class="rect-width-list">
        <view class="rect-width-item {{rectStrokeWidth === 1 ? 'active' : ''}}" bindtap="onRectStrokeWidth" data-width="1">1px</view>
        <view class="rect-width-item {{rectStrokeWidth === 2 ? 'active' : ''}}" bindtap="onRectStrokeWidth" data-width="2">2px</view>
        <view class="rect-width-item {{rectStrokeWidth === 4 ? 'active' : ''}}" bindtap="onRectStrokeWidth" data-width="4">4px</view>
        <view class="rect-width-item {{rectStrokeWidth === 8 ? 'active' : ''}}" bindtap="onRectStrokeWidth" data-width="8">8px</view>
      </view>

      <text class="eyebrow">填充颜色</text>
      <scroll-view scroll-x class="color-scroll" enhanced show-scrollbar="{{false}}">
        <view class="color-list">
          <view class="color-item {{rectFillColor === 'transparent' ? 'active' : ''}}" style="background: transparent; border: 2rpx dashed #666;" bindtap="onRectFillColor" data-color="transparent">
            <text style="font-size: 16rpx; color: #666;">无</text>
          </view>
          <view class="color-item {{rectFillColor === item ? 'active' : ''}}" wx:for="{{rectFillColors}}" wx:key="*this" style="background: {{item}};" bindtap="onRectFillColor" data-color="{{item}}"></view>
          <view class="color-item color-picker-btn" bindtap="openRectFillColorPicker">
            <text class="picker-icon">+</text>
          </view>
        </view>
      </scroll-view>

      <text class="eyebrow">描边颜色</text>
      <scroll-view scroll-x class="color-scroll" enhanced show-scrollbar="{{false}}">
        <view class="color-list">
          <view class="color-item {{rectStrokeColor === item ? 'active' : ''}}" wx:for="{{rectStrokeColors}}" wx:key="*this" style="background: {{item}};" bindtap="onRectStrokeColor" data-color="{{item}}"></view>
          <view class="color-item color-picker-btn" bindtap="openRectStrokeColorPicker">
            <text class="picker-icon">+</text>
          </view>
        </view>
      </scroll-view>

      <view class="btn btn-primary" bindtap="addRect">添加到画布</view>
    </view>
  </view>

  <view class="panel {{showBgPanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="panel-header">
      <text class="panel-title">页面背景</text>
      <view class="panel-close" bindtap="toggleBgPanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="panel-body">
      <text class="eyebrow">颜色</text>
      <view class="bg-color-grid">
        <view class="bg-color-item {{background === item ? 'active' : ''}}" wx:for="{{bgColors}}" wx:key="*this" style="background: {{item}};" bindtap="onChangeBackground" data-color="{{item}}"></view>
        <view class="bg-color-item color-picker-btn" bindtap="onChangeBackground" data-color="picker">
          <text class="picker-icon">+</text>
        </view>
      </view>

      <text class="eyebrow">纸面纹路</text>
      <view class="pattern-list">
        <view class="pattern-item {{bgPattern === 'blank' ? 'active' : ''}}" bindtap="onChangePattern" data-pattern="blank">空白</view>
        <view class="pattern-item {{bgPattern === 'dots' ? 'active' : ''}}" bindtap="onChangePattern" data-pattern="dots">点阵</view>
        <view class="pattern-item {{bgPattern === 'lines' ? 'active' : ''}}" bindtap="onChangePattern" data-pattern="lines">横线</view>
        <view class="pattern-item {{bgPattern === 'grid' ? 'active' : ''}}" bindtap="onChangePattern" data-pattern="grid">网格</view>
      </view>

      <text class="eyebrow">纸面材质</text>
      <view class="paper-texture-list">
        <view class="paper-texture-item {{bgTexture === 'none' ? 'active' : ''}}" bindtap="onChangeTexture" data-texture="none">
          <view class="texture-preview texture-none"></view>
          <text>光滑</text>
        </view>
        <view class="paper-texture-item {{bgTexture === 'grain' ? 'active' : ''}}" bindtap="onChangeTexture" data-texture="grain">
          <view class="texture-preview texture-grain"></view>
          <text>纸纹</text>
        </view>
        <view class="paper-texture-item {{bgTexture === 'canvas' ? 'active' : ''}}" bindtap="onChangeTexture" data-texture="canvas">
          <view class="texture-preview texture-canvas"></view>
          <text>画布</text>
        </view>
        <view class="paper-texture-item {{bgTexture === 'kraft' ? 'active' : ''}}" bindtap="onChangeTexture" data-texture="kraft">
          <view class="texture-preview texture-kraft"></view>
          <text>牛皮纸</text>
        </view>
        <view class="paper-texture-item {{bgTexture === 'linen' ? 'active' : ''}}" bindtap="onChangeTexture" data-texture="linen">
          <view class="texture-preview texture-linen"></view>
          <text>亚麻</text>
        </view>
        <view class="paper-texture-item {{bgTexture === 'watercolor' ? 'active' : ''}}" bindtap="onChangeTexture" data-texture="watercolor">
          <view class="texture-preview texture-watercolor"></view>
          <text>水彩</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 边框面板 -->
  <view class="panel {{showBorderPanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="panel-header">
      <text class="panel-title">元素边框</text>
      <view class="panel-close" bindtap="closeBorderPanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="panel-body">
      <text class="eyebrow">边框颜色</text>
      <scroll-view scroll-x class="color-scroll" enhanced show-scrollbar="{{false}}">
        <view class="color-list">
          <view class="color-item {{borderColor === item ? 'active' : ''}}" wx:for="{{borderColors}}" wx:key="*this" style="background: {{item}};" bindtap="onBorderColor" data-color="{{item}}"></view>
          <view class="color-item color-picker-btn" bindtap="openBorderColorPicker">
            <text class="picker-icon">+</text>
          </view>
        </view>
      </scroll-view>

      <text class="eyebrow">边框粗细</text>
      <view class="border-width-list">
        <view class="border-width-item {{borderWidth === 1 ? 'active' : ''}}" bindtap="onBorderWidth" data-width="1">1px</view>
        <view class="border-width-item {{borderWidth === 2 ? 'active' : ''}}" bindtap="onBorderWidth" data-width="2">2px</view>
        <view class="border-width-item {{borderWidth === 4 ? 'active' : ''}}" bindtap="onBorderWidth" data-width="4">4px</view>
        <view class="border-width-item {{borderWidth === 8 ? 'active' : ''}}" bindtap="onBorderWidth" data-width="8">8px</view>
      </view>

      <text class="eyebrow">边框样式</text>
      <view class="border-style-list">
        <view class="border-style-item {{borderStyle === 'solid' ? 'active' : ''}}" bindtap="onBorderStyle" data-style="solid">
          <view class="border-preview border-solid"></view>
          <text>实线</text>
        </view>
        <view class="border-style-item {{borderStyle === 'dashed' ? 'active' : ''}}" bindtap="onBorderStyle" data-style="dashed">
          <view class="border-preview border-dashed"></view>
          <text>虚线</text>
        </view>
        <view class="border-style-item {{borderStyle === 'dotted' ? 'active' : ''}}" bindtap="onBorderStyle" data-style="dotted">
          <view class="border-preview border-dotted"></view>
          <text>点线</text>
        </view>
      </view>

      <text class="eyebrow">圆角</text>
      <view class="border-width-list">
        <view class="border-width-item {{borderRadius === 0 ? 'active' : ''}}" bindtap="onBorderRadius" data-radius="0">0</view>
        <view class="border-width-item {{borderRadius === 8 ? 'active' : ''}}" bindtap="onBorderRadius" data-radius="8">8</view>
        <view class="border-width-item {{borderRadius === 16 ? 'active' : ''}}" bindtap="onBorderRadius" data-radius="16">16</view>
        <view class="border-width-item {{borderRadius === 50 ? 'active' : ''}}" bindtap="onBorderRadius" data-radius="50">50</view>
      </view>
    </view>
  </view>

  <!-- 填充图片拖拽调整位置 -->
  <view class="fill-image-drag-modal {{showFillImagePanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="fidm-header">
      <text class="fidm-title">{{fillImagePanelTitle}}</text>
      <view class="fidm-close" bindtap="closeFillImagePanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="fidm-body">
      <canvas
        type="2d"
        id="fillImageDragCanvas"
        class="fidm-canvas"
        disable-scroll="{{true}}"
        bindtouchstart="onFillImageDragStart"
        bindtouchmove="onFillImageDragMove"
        bindtouchend="onFillImageDragEnd"
      />
      <view class="fidm-hint" wx:if="{{!fillImageDragReady}}">加载中...</view>
    </view>
    <view class="fidm-footer">
      <view class="fidm-btn fidm-btn-reset" bindtap="onFillImageDragReset">重置</view>
      <view class="fidm-btn fidm-btn-confirm" bindtap="confirmFillImagePosition">完成</view>
    </view>
  </view>

  <view class="panel {{showTemplatePanel ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="panel-header">
      <text class="panel-title">页面模板</text>
      <view class="panel-close" bindtap="toggleTemplatePanel" hover-class="soft-hover" hover-stay-time="80">
        <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
      </view>
    </view>
    <scroll-view scroll-x class="template-tabs" enhanced show-scrollbar="{{false}}">
      <view class="tab-list">
        <view class="tab-item {{activeTemplateCategory === item ? 'active' : ''}}" wx:for="{{templateCategories}}" wx:key="*this" bindtap="onTemplateCategory" data-category="{{item}}" hover-class="soft-hover" hover-stay-time="80">
          {{item}}
        </view>
      </view>
    </scroll-view>
  <scroll-view scroll-y class="panel-scroll">
    <view class="template-grid">
      <view class="template-card template-clear-card" wx:if="{{activeTemplateCategory === '全部'}}" bindtap="onClearPage">
        <view class="template-preview clear-preview">
          <image class="clear-icon" src="/assets/icons/trash-2.svg" mode="aspectFit" />
        </view>
        <text class="template-name">一键清空页面</text>
      </view>
      <view class="template-card" wx:for="{{templates}}" wx:key="id" bindtap="onTapTemplate" data-id="{{item.id}}">
          <view class="template-preview" style="background: {{item.background || '#fdf9ef'}};">
          <view class="template-tape"></view>
          <view class="template-title-line"></view>
          <view class="template-photo-mark"></view>
          <view class="template-lines"></view>
          <view class="template-note-line line-a"></view>
          <view class="template-note-line line-b"></view>
          <view class="template-dot dot-a"></view>
          <view class="template-dot dot-b"></view>
          </view>
          <text class="template-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="panel-mask {{showBgPanel || showStickerPanel || showTextPanel || showTemplatePanel || showRectPanel || showBorderPanel || showDrawPanel ? 'show' : ''}}" bindtap="closeAllPanels"></view>

  <!-- 调色盘弹窗 -->
  <view class="color-picker-mask {{showColorPicker ? 'show' : ''}}" bindtap="closeColorPicker">
    <view class="color-picker-modal" catchtap="stopPropagation">
      <view class="color-picker-header">
        <text class="color-picker-title">选择颜色</text>
      <view class="color-picker-close" bindtap="closeColorPicker" hover-class="soft-hover" hover-stay-time="80">
          <image class="ui-icon" src="/assets/icons/x.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="color-picker-body">
        <view class="color-preview" style="background: {{colorPickerTarget === 'text' ? textColor : colorPickerTarget === 'rectFill' ? rectFillColor : colorPickerTarget === 'rectStroke' ? rectStrokeColor : colorPickerTarget === 'border' ? borderColor : background}};"></view>
        <view class="color-slider-group">
          <view class="slider-row">
            <text class="slider-label">色相</text>
            <slider class="color-slider hue-slider" min="0" max="360" value="{{colorPickerHue}}" bindchange="onColorPickerHueChange" activeColor="#ff0000" />
          </view>
          <view class="slider-row">
            <text class="slider-label">饱和度</text>
            <slider class="color-slider" min="0" max="100" value="{{colorPickerSaturation}}" bindchange="onColorPickerSatChange" activeColor="#888" />
          </view>
          <view class="slider-row">
            <text class="slider-label">明度</text>
            <slider class="color-slider" min="0" max="100" value="{{colorPickerValue}}" bindchange="onColorPickerValChange" activeColor="#888" />
          </view>
        </view>
        <view class="color-picker-actions">
          <view class="btn btn-secondary" bindtap="closeColorPicker">取消</view>
          <view class="btn btn-primary" bindtap="confirmColorPicker">确定</view>
        </view>
      </view>
    </view>
  </view>
</view>
