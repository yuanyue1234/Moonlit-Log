  border-radius: 8rpx;
}

.draw-side-toolbar {
  position: absolute;
  top: 108rpx;
  left: 18rpx;
  z-index: 7;
  width: 76rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx;
  border: 1rpx solid #eadccf;
  border-radius: 8rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 14rpx 32rpx rgba(122, 86, 58, 0.16);
  box-sizing: border-box;
}

.draw-icon-tool {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.draw-icon-tool image {
  width: 34rpx;
  height: 34rpx;
}

.draw-icon-tool.active {
  background: #d98eaa;
  border-color: #d98eaa;
}

.draw-icon-tool.active image {
  filter: brightness(0) invert(1);
}

.draw-color-tool.active .draw-current-color {
  box-shadow: 0 0 0 4rpx #fffdf8;
}

.draw-parameter-stack {
  position: absolute;
  left: 22rpx;
  bottom: calc(26rpx + env(safe-area-inset-bottom));
  z-index: 6;
  width: 68rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.draw-vertical-control {
  position: relative;
  width: 68rpx;
  height: 172rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
  border: 1rpx solid #eadccf;
  border-radius: 8rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 12rpx 28rpx rgba(122, 86, 58, 0.12);
  box-sizing: border-box;
}

.draw-vertical-control > image {
  width: 26rpx;
  height: 26rpx;
}

.draw-vertical-slider {
  position: absolute;
  left: -52rpx;
  bottom: 64rpx;
  width: 170rpx;
  margin: 0;
  transform: rotate(-90deg);
}

.draw-color-popover {
  left: 104rpx;
  right: auto;
  bottom: auto;
  top: 180rpx;
  width: 210rpx;
  padding: 14rpx;
  border-radius: 8rpx;
}

.draw-color-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.draw-color-item {
  width: 50rpx;
  height: 50rpx;
  flex: none;
}

.draw-custom-color {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf8;
}

.draw-custom-color image {
  width: 28rpx;
  height: 28rpx;
}

.draw-layer-panel {
  position: absolute;
  top: 350rpx;
  left: 104rpx;
  z-index: 8;
  display: none;
  width: 210rpx;
  padding: 12rpx;
  border: 1rpx solid #eadccf;
  border-radius: 8rpx;
  background: rgba(255, 253, 248, 0.97);
  box-shadow: 0 16rpx 36rpx rgba(122, 86, 58, 0.18);
  box-sizing: border-box;
}

.draw-layer-panel.show {
  display: block;
}

.draw-layer-header,
.draw-layer-row {
  display: flex;
  align-items: center;
}

.draw-layer-header {
  justify-content: space-between;
  padding: 4rpx 6rpx 12rpx;
}

.draw-layer-header > image,
.draw-layer-add image,
.draw-layer-delete image {
  width: 28rpx;
  height: 28rpx;
}

.draw-layer-add,
.draw-layer-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.draw-layer-row {
  height: 52rpx;
  gap: 10rpx;
  padding: 0 4rpx 0 10rpx;
  border-radius: 6rpx;
  color: #7b665a;
}

.draw-layer-row.active {
  background: #fdeaf1;
  color: #b96e8b;
}

.draw-layer-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.draw-layer-row text {
  flex: 1;
  font-size: 20rpx;
}

.shape-line {
  width: 72rpx;
  height: 3rpx;
  background: #7b665a;
  transform: rotate(-12deg);
}

.shape-curve {
  width: 66rpx;
  height: 32rpx;
  border-top: 4rpx solid #7b665a;
  border-radius: 50%;
  transform: rotate(-10deg);
}

.text-component-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin: 22rpx 0;
}

.text-component-btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid #eadccf;
  border-radius: 8rpx;
  background: #fffdf8;
  color: #7b665a;
}

.text-component-btn image {
  width: 32rpx;
  height: 32rpx;
}

.color-picker-mask {
  z-index: 1600;
}
