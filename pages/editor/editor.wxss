/* pages/editor/editor.wxss - 编辑器页面 */
.editor-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #101010;
  overflow: hidden;
}

/* 顶部工具栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #101010;
  border-bottom: 1rpx solid #3d3a39;
  z-index: 10;
}

.tool-icon-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #C4956A;
  line-height: 1;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
}

.back-icon {
  font-size: 32rpx;
  color: #f2f2f2;
}

.page-info {
  display: flex;
  flex-direction: column;
}

.page-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-hint {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #00d992;
}

.top-right {
  display: flex;
  gap: 8rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f2f2f2;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  transition: all 0.15s;
}

.action-hover {
  border-color: #00d992;
  box-shadow: 0 0 12rpx rgba(0, 217, 146, 0.15);
}

.action-btn.disabled {
  opacity: 0.3;
}

.export-btn {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
}

/* 鐢诲竷鍖哄煙 */
.canvas-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  overflow: hidden;
}

.canvas-container {
  background: #1a1a1a;
  border-radius: 16rpx;
  border: 1rpx solid #3d3a39;
  overflow: hidden;
  position: relative;
}

.editor-canvas {
  display: block;
}

/* ── 选中工具栏 ── */
.selection-toolbar {
  position: fixed;
  width: auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx 10rpx 12rpx;
  background: rgba(18, 18, 18, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.5), 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  z-index: 21;
  white-space: nowrap;
  opacity: 0.9;
}

.toolbar-drag-handle {
  width: 28rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
  cursor: grab;
  touch-action: none;
}

.grip-icon {
  width: 20rpx;
  height: 20rpx;
  filter: invert(70%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(85%) contrast(80%);
  opacity: 0.7;
}

.sel-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  transition: all 0.18s;
  background: transparent;
  position: relative;
  flex-shrink: 0;
}

.sel-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

.sel-btn.active {
  background: rgba(0, 217, 146, 0.18);
}

.sel-btn .ui-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
  filter: invert(96%) sepia(4%) saturate(186%) hue-rotate(183deg) brightness(103%) contrast(92%);
}

/* tooltip — 长按/触摸时显示在按钮上方 */
.sel-btn::after {
  content: attr(data-tooltip);
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #fff;
  background: rgba(40, 40, 40, 0.96);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.15s;
  z-index: 10;
}

.sel-btn:active::after {
  opacity: 1;
}

.sel-btn.danger {
  /* 删除按钮红色提示 */
}

.sel-btn.danger .ui-icon {
  filter: invert(57%) sepia(97%) saturate(2454%) hue-rotate(329deg) brightness(101%) contrast(97%);
}

.sel-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.selected-more-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 35, 40, 0.24);
  opacity: 0;
  pointer-events: none;
  z-index: 118;
  transition: opacity 0.16s ease;
}

.selected-more-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.selected-more-sheet {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding: 24rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(31, 35, 40, 0.1);
  border-radius: 24rpx;
  box-shadow: 0 24rpx 70rpx rgba(31, 35, 40, 0.2);
  opacity: 0;
  transform: translateY(28rpx);
  pointer-events: none;
  z-index: 119;
  transition: opacity 0.16s ease, transform 0.16s ease;
  box-sizing: border-box;
}

.selected-more-sheet.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.selected-more-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
}

.selected-more-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(31, 35, 40, 0.06);
}

.selected-more-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.selected-more-item {
  min-height: 82rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.08);
  color: #202124;
  font-size: 26rpx;
  box-sizing: border-box;
}

.selected-more-item:active {
  background: rgba(0, 217, 146, 0.12);
  border-color: rgba(0, 217, 146, 0.35);
}

.selected-more-icon {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
}

/* 浮动工具条 */
.floating-tool-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.22);
  z-index: 20;
  backdrop-filter: blur(16rpx);
}

.tool-group {
  display: flex;
  gap: 4rpx;
}

.tool-divider {
  width: 1rpx;
  height: 40rpx;
  background: #3d3a39;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  transition: all 0.15s;
  min-width: 76rpx;
  color: #202124;
}

.tool-btn .ui-icon {
  width: 32rpx;
  height: 32rpx;
  filter: none;
}

.tool-btn text {
  font-size: 18rpx;
  color: #202124;
  line-height: 1.2;
}

.tool-label {
  font-size: 24rpx;
  color: #f2f2f2;
  font-weight: 500;
}

.tool-label.disabled {
  color: #3d3a39;
}

.tool-btn:active,
.tool-btn.active {
  background: #eef7f3;
  border: 1rpx solid rgba(0, 217, 146, 0.38);
}

.tool-btn.active {
  border-color: #00d992;
}

.tool-icon {
  font-size: 32rpx;
  line-height: 1;
}

.tool-text {
  font-size: 18rpx;
  color: #8b949e;
}

/* ===== 闈㈡澘閫氱敤 ===== */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.panel-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #101010;
  border-radius: 32rpx 32rpx 0 0;
  border-top: 1rpx solid #3d3a39;
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.panel.show {
  transform: translateY(0);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #3d3a39;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8b949e;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
}

/* 素材面板搜索栏 */
.panel-search-bar {
  flex: 1;
  margin: 0 12rpx;
  height: 52rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
}

.panel-search-input {
  flex: 1;
  font-size: 24rpx;
  color: #f2f2f2;
  height: 36rpx;
  line-height: 36rpx;
}

.search-placeholder {
  color: #6e7681;
}

/* 素材面板分组栏 */
.panel-categories {
  padding: 16rpx 32rpx 8rpx;
}

.panel-categories .category-scroll {
  white-space: nowrap;
}

.panel-categories .category-list {
  display: flex;
  gap: 10rpx;
}

.panel-categories .category-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 24rpx;
  color: #8b949e;
  white-space: nowrap;
  flex-shrink: 0;
}

.panel-categories .category-tag.active {
  background: rgba(0, 217, 146, 0.15);
  border-color: rgba(0, 217, 146, 0.4);
  color: #00d992;
}

.panel-scroll {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
}

.panel-body {
  padding: 24rpx 32rpx;
}

.panel-section {
  margin-bottom: 32rpx;
}

/* ===== 当下组件（素材面板内） ===== */
.widget-section {
  margin-bottom: 24rpx;
}
.panel-eyebrow {
  font-size: 22rpx;
  color: #8b949e;
  padding: 0 0 12rpx 0;
}
.widget-scroll {
  white-space: nowrap;
}
.widget-list {
  display: flex;
  gap: 16rpx;
}
.widget-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 130rpx;
  height: 130rpx;
  border-radius: 20rpx;
  background: rgba(0, 217, 146, 0.08);
  border: 1rpx solid rgba(0, 217, 146, 0.2);
  flex-shrink: 0;
  transition: all 0.15s;
}
.widget-card:active {
  background: rgba(0, 217, 146, 0.18);
  border-color: rgba(0, 217, 146, 0.4);
}
.widget-icon {
  font-size: 36rpx;
  line-height: 1;
}
.widget-label {
  font-size: 22rpx;
  color: #8b949e;
}

/* ===== 璐寸焊缃戞牸 ===== */
.sticker-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sticker-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  transition: all 0.15s;
}

.sticker-hover {
  border-color: #00d992;
  background: rgba(0, 217, 146, 0.08);
}

.user-sticker {
  width: 100rpx;
  height: 100rpx;
  overflow: hidden;
}

.sticker-img {
  width: 80rpx;
  height: 80rpx;
}

/* ===== 装饰网格 ===== */
.decoration-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.deco-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  min-width: 120rpx;
  transition: all 0.15s;
}

.deco-item:active {
  border-color: #00d992;
  background: rgba(0, 217, 146, 0.08);
}

.deco-name {
  font-size: 18rpx;
  color: #8b949e;
  white-space: nowrap;
}

/* ===== 鏂囧瓧闈㈡澘 ===== */
.text-input {
  width: 100%;
  min-height: 120rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #f2f2f2;
  box-sizing: border-box;
}

.input-placeholder {
  color: #8b949e;
}

.text-options {
  margin-top: 24rpx;
}

.color-scroll, .size-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.color-list, .size-list {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.color-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #3d3a39;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s;
}

.color-item.active {
  border-color: #00d992;
  box-shadow: 0 0 12rpx rgba(0, 217, 146, 0.3);
}

.color-check {
  font-size: 24rpx;
  color: #00d992;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.5);
}

.size-item {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 22rpx;
  color: #8b949e;
  flex-shrink: 0;
  transition: all 0.15s;
}

.size-item.active {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
}

/* ===== 鑳屾櫙闈㈡澘 ===== */
.bg-color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.bg-color-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #3d3a39;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.bg-color-item.active {
  border-color: #00d992;
  box-shadow: 0 0 12rpx rgba(0, 217, 146, 0.3);
}

.bg-check {
  font-size: 28rpx;
  color: #00d992;
}

.pattern-list {
  display: flex;
  gap: 16rpx;
}

.pattern-item {
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 22rpx;
  color: #8b949e;
  transition: all 0.15s;
}

.pattern-item.active {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
}

/* 调色盘按钮 */
.color-picker-btn {
  background: linear-gradient(135deg, #ff0000, #ff8800, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff);
  border: 2rpx solid #ffffff;
}

.picker-icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 纸面材质 */
.paper-texture-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.paper-texture-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  min-width: 100rpx;
  transition: all 0.15s;
}

.paper-texture-item.active {
  border-color: #00d992;
  background: rgba(0, 217, 146, 0.1);
}

.paper-texture-item text {
  font-size: 20rpx;
  color: #8b949e;
}

.paper-texture-item.active text {
  color: #00d992;
}

.texture-preview {
  width: 80rpx;
  height: 60rpx;
  border-radius: 8rpx;
  background: #fdf9ef;
  border: 1rpx solid rgba(80, 64, 42, 0.12);
  box-shadow: inset 0 1rpx 6rpx rgba(80, 64, 42, 0.12);
  overflow: hidden;
}

.texture-none {
  background: linear-gradient(135deg, #fffdf7 0%, #f7efe2 100%);
}

.texture-grain {
  background-color: #fdf7ec;
  background-image:
    radial-gradient(circle at 18% 22%, rgba(80, 64, 42, 0.2) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 72% 58%, rgba(188, 152, 104, 0.28) 0 1rpx, transparent 2rpx),
    linear-gradient(110deg, rgba(80, 64, 42, 0.08), transparent 42%),
    linear-gradient(135deg, #fffaf1 0%, #f4ead8 100%);
  background-size: 11rpx 11rpx, 17rpx 17rpx, 100% 100%, 100% 100%;
}

.texture-canvas {
  background-color: #f9f2e6;
  background-image:
    repeating-linear-gradient(0deg, rgba(80, 64, 42, 0.16) 0 1rpx, transparent 1rpx 7rpx),
    repeating-linear-gradient(90deg, rgba(188, 152, 104, 0.16) 0 1rpx, transparent 1rpx 7rpx),
    linear-gradient(135deg, #fff8ed 0%, #eee2cf 100%);
}

.texture-kraft {
  background-color: #d8aa73;
  background-image:
    radial-gradient(circle at 25% 35%, rgba(88, 60, 34, 0.2) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 75% 70%, rgba(255, 231, 178, 0.18) 0 1rpx, transparent 2rpx),
    repeating-linear-gradient(12deg, rgba(96, 66, 36, 0.14) 0 1rpx, transparent 1rpx 13rpx),
    linear-gradient(135deg, #e2ba82 0%, #bd8753 100%);
  background-size: 15rpx 15rpx, 19rpx 19rpx, 100% 100%, 100% 100%;
}

.texture-linen {
  background-color: #f6efe4;
  background-image:
    repeating-linear-gradient(0deg, rgba(80, 64, 42, 0.13) 0 1rpx, transparent 1rpx 8rpx),
    repeating-linear-gradient(90deg, rgba(80, 64, 42, 0.1) 0 1rpx, transparent 1rpx 10rpx),
    repeating-linear-gradient(45deg, rgba(188, 152, 104, 0.08) 0 1rpx, transparent 1rpx 14rpx),
    linear-gradient(135deg, #fff9ee 0%, #e9decc 100%);
}

.texture-watercolor {
  background-color: #fff8ef;
  background-image:
    radial-gradient(circle at 30% 35%, rgba(188, 152, 104, 0.26) 0 12rpx, transparent 26rpx),
    radial-gradient(circle at 78% 70%, rgba(80, 64, 42, 0.12) 0 10rpx, transparent 24rpx),
    radial-gradient(circle at 68% 20%, rgba(255, 201, 196, 0.24) 0 8rpx, transparent 22rpx),
    linear-gradient(135deg, #fffaf2 0%, #f2e4d6 100%);
}

/* 调色盘弹窗 */
.color-picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.color-picker-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.color-picker-modal {
  width: 600rpx;
  background: #1a1a1a;
  border-radius: 24rpx;
  border: 1rpx solid #3d3a39;
  overflow: hidden;
}

.color-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #3d3a39;
}

.color-picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f2f2f2;
}

.color-picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
