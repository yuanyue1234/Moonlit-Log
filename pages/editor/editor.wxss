  background: #ffffff;
  color: #697077;
  border-color: rgba(31, 35, 40, 0.14);
}

.page-dot.active {
  background: #202124;
  color: #ffffff;
  border-color: #202124;
  box-shadow: 0 6rpx 16rpx rgba(31, 35, 40, 0.18);
}

.add-dot {
  color: #1b6f4a;
  border-color: #52b788;
}

.panel-mask {
  background: rgba(31, 35, 40, 0.24);
}

.panel {
  background: #fffdf7;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid rgba(31, 35, 40, 0.1);
}

.panel-header {
  padding: 28rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(31, 35, 40, 0.1);
}

.panel-title {
  display: block;
  color: #202124;
}

.panel-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #697077;
}

.panel-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  box-shadow: none;
}

.panel-scroll,
.panel-body {
  padding: 24rpx 28rpx;
}

.eyebrow {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #697077;
  font-size: 20rpx;
  font-weight: 700;
}

.sticker-grid {
  gap: 14rpx;
}

.sticker-item {
  background: #ffffff;
  border-color: rgba(31, 35, 40, 0.12);
}

.user-sticker {
  width: 124rpx;
  height: 124rpx;
}

.sticker-img {
  width: 104rpx;
  height: 104rpx;
}

.empty-stickers {
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  color: #697077;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  color: #202124;
  font-weight: 700;
}

.empty-hint {
  font-size: 23rpx;
  line-height: 1.5;
}

.text-input {
  color: #202124;
  background: #ffffff;
  border-color: rgba(31, 35, 40, 0.14);
}

.input-placeholder {
  color: #9aa0a6;
}

.font-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.font-item {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.14);
  color: #202124;
  font-size: 24rpx;
  overflow: hidden;
}

.font-item.active,
.size-item.active,
.pattern-item.active {
  background: #202124;
  color: #ffffff;
  border-color: #202124;
}

.color-item {
  border-color: rgba(31, 35, 40, 0.18);
}

.color-item.active {
  border-color: #202124;
  box-shadow: 0 0 0 4rpx rgba(32, 33, 36, 0.12);
}

.size-item,
.pattern-item {
  background: #ffffff;
  border-color: rgba(31, 35, 40, 0.14);
  color: #202124;
}

.bg-color-item {
  border-color: rgba(31, 35, 40, 0.18);
}

.bg-color-item.active {
  border-color: #202124;
  box-shadow: 0 0 0 4rpx rgba(32, 33, 36, 0.12);
}

.template-tabs {
  border-bottom: 1rpx solid rgba(31, 35, 40, 0.1);
}

.tab-item {
  color: #697077;
}

.tab-item.active {
  color: #202124;
  background: #f2eee4;
}

.template-preview {
  background: #fffaf0;
  border-color: rgba(31, 35, 40, 0.14);
}

.template-lines {
  width: 68%;
  height: 60%;
  border-top: 2rpx solid rgba(80, 64, 42, 0.18);
  border-bottom: 2rpx solid rgba(80, 64, 42, 0.18);
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 18rpx,
    rgba(80, 64, 42, 0.14) 19rpx
  );
}

.template-name {
  color: #3f454b;
}

.btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.btn-primary {
  background: #202124;
  color: #ffffff;
}


.preview-mode .floating-tool-dock,
.preview-mode .selection-toolbar {
  display: none;
}

/* ===== Icon pack + dark shell overrides ===== */
.ui-icon {
  width: 30rpx;
  height: 30rpx;
  display: block;
  filter: invert(96%) sepia(4%) saturate(186%) hue-rotate(183deg) brightness(103%) contrast(92%);
}

.icon-btn.disabled .ui-icon {
  opacity: 0.35;
}

.editor-page {
  background: #101010;
  color: #f2f2f2;
}

.top-bar,
.page-dots-bar,
.selection-toolbar {
  background: rgba(16, 16, 16, 0.98);
  border-color: #2c2c2c;
}

.icon-btn,
.mode-toggle,
.panel-close,
.sel-btn,
.sticker-item,
.size-item,
.pattern-item,
.font-item {
  background: #1a1a1a;
  border-color: #3d3a39;
  color: #f2f2f2;
}

.mode-toggle text,
.tool-btn text,
.sel-btn text,
.panel-title,
.page-name,
.template-name,
.font-item,
.empty-title {
  color: #f2f2f2;
}

.page-hint,
.panel-subtitle,
.empty-hint,
.tab-item,
.template-name {
  color: #8b949e;
}

.export-btn,
.mode-toggle.active,
.tool-btn.active,
.page-dot.active,
.font-item.active,
.size-item.active,
.pattern-item.active,
.btn-primary {
  background: #00d992;
  border-color: #00d992;
  color: #101010;
}

.export-btn .ui-icon,
.mode-toggle.active .ui-icon,
.tool-btn.active .ui-icon {
  filter: invert(5%) sepia(8%) saturate(452%) hue-rotate(314deg) brightness(97%) contrast(92%);
}

.mode-toggle.active text,
.tool-btn.active text,
.page-dot.active,
.font-item.active,
.size-item.active,
.pattern-item.active {
  color: #101010;
}

.canvas-wrapper {
  background:
    linear-gradient(90deg, rgba(255,255,255,0.04) 1rpx, transparent 1rpx) 0 0 / 36rpx 36rpx,
    linear-gradient(0deg, rgba(255,255,255,0.04) 1rpx, transparent 1rpx) 0 0 / 36rpx 36rpx,
    #101010;
}

.page-shell {
  background: #191919;
  border-color: #3d3a39;
  box-shadow: 0 24rpx 50rpx rgba(0, 0, 0, 0.35);
}

.panel {
  background: #101010;
  border-top-color: #3d3a39;
}

.panel-header {
  border-bottom-color: #3d3a39;
}

.text-input {
  background: #1a1a1a;
  color: #f2f2f2;
  border-color: #3d3a39;
}

.floating-tool-dock {
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(31, 35, 40, 0.12);
}

.floating-tool-dock .tool-btn {
  background: transparent;
  border-color: transparent;
  color: #202124;
}

.floating-tool-dock .tool-btn text {
  color: #202124;
}

.floating-tool-dock .tool-btn .ui-icon {
  filter: none;
}

.floating-tool-dock .tool-btn.active {
  background: #eef7f3;
  border-color: rgba(0, 217, 146, 0.45);
}

.floating-tool-dock .tool-btn.active text {
  color: #1b6f4a;
}

