/* pages/editor/editor.wxss - 鏆楄壊涓婚 */
.editor-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #101010;
  overflow: hidden;
}

/* 椤堕儴宸ュ叿鏍?*/
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #101010;
  border-bottom: 1rpx solid #3d3a39;
  z-index: 10;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
}

.back-icon {
  font-size: 32rpx;
  color: #f2f2f2;
}

.page-info {
  display: flex;
  flex-direction: column;
}

.page-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-hint {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #00d992;
}

.top-right {
  display: flex;
  gap: 8rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f2f2f2;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  transition: all 0.15s;
}

.action-hover {
  border-color: #00d992;
  box-shadow: 0 0 12rpx rgba(0, 217, 146, 0.15);
}

.action-btn.disabled {
  opacity: 0.3;
}

.export-btn {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
}

/* 鐢诲竷鍖哄煙 */
.canvas-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  overflow: hidden;
}

.canvas-container {
  background: #1a1a1a;
  border-radius: 16rpx;
  border: 1rpx solid #3d3a39;
  overflow: hidden;
  position: relative;
}

.editor-canvas {
  display: block;
}

/* 閫変腑鎿嶄綔鏍?*/
.selection-toolbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 202rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 35, 40, 0.12);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.22);
  z-index: 21;
  backdrop-filter: blur(16rpx);
}

.sel-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  transition: all 0.15s;
}

.sel-hover {
  background: #1a1a1a;
}

.sel-btn.danger .sel-icon {
  color: #ff6b6b;
}

.sel-icon {
  font-size: 28rpx;
  color: #00d992;
}

.sel-label {
  font-size: 18rpx;
  color: #8b949e;
}

/* 浮动工具条 */
.floating-tool-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.22);
  z-index: 20;
  backdrop-filter: blur(16rpx);
}

.tool-group {
  display: flex;
  gap: 4rpx;
}

.tool-divider {
  width: 1rpx;
  height: 40rpx;
  background: #3d3a39;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  transition: all 0.15s;
  min-width: 76rpx;
  color: #202124;
}

.tool-btn .ui-icon {
  width: 32rpx;
  height: 32rpx;
  filter: none;
}

.tool-btn text {
  font-size: 18rpx;
  color: #202124;
  line-height: 1.2;
}

.tool-label {
  font-size: 24rpx;
  color: #f2f2f2;
  font-weight: 500;
}

.tool-label.disabled {
  color: #3d3a39;
}

.tool-btn:active,
.tool-btn.active {
  background: #eef7f3;
  border: 1rpx solid rgba(0, 217, 146, 0.38);
}

.tool-btn.active {
  border-color: #00d992;
}

.tool-icon {
  font-size: 32rpx;
  line-height: 1;
}

.tool-text {
  font-size: 18rpx;
  color: #8b949e;
}

/* ===== 闈㈡澘閫氱敤 ===== */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.panel-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #101010;
  border-radius: 32rpx 32rpx 0 0;
  border-top: 1rpx solid #3d3a39;
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.panel.show {
  transform: translateY(0);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #3d3a39;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8b949e;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
}

.panel-scroll {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
}

.panel-body {
  padding: 24rpx 32rpx;
}

.panel-section {
  margin-bottom: 32rpx;
}

/* ===== 璐寸焊缃戞牸 ===== */
.sticker-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sticker-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  transition: all 0.15s;
}

.sticker-hover {
  border-color: #00d992;
  background: rgba(0, 217, 146, 0.08);
}

.user-sticker {
  width: 100rpx;
  height: 100rpx;
  overflow: hidden;
}

.sticker-img {
  width: 80rpx;
  height: 80rpx;
}

/* ===== 瑁呴グ缃戞牸 ===== */
.decoration-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.deco-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  min-width: 120rpx;
  transition: all 0.15s;
}

.deco-item:active {
  border-color: #00d992;
  background: rgba(0, 217, 146, 0.08);
}

.deco-name {
  font-size: 18rpx;
  color: #8b949e;
  white-space: nowrap;
}

/* ===== 鏂囧瓧闈㈡澘 ===== */
.text-input {
  width: 100%;
  min-height: 120rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #f2f2f2;
  box-sizing: border-box;
}

.input-placeholder {
  color: #8b949e;
}

.text-options {
  margin-top: 24rpx;
}

.color-scroll, .size-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.color-list, .size-list {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.color-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #3d3a39;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s;
}

.color-item.active {
  border-color: #00d992;
  box-shadow: 0 0 12rpx rgba(0, 217, 146, 0.3);
}

.color-check {
  font-size: 24rpx;
  color: #00d992;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.5);
}

.size-item {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 22rpx;
  color: #8b949e;
  flex-shrink: 0;
  transition: all 0.15s;
}

.size-item.active {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
}

/* ===== 鑳屾櫙闈㈡澘 ===== */
.bg-color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.bg-color-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #3d3a39;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.bg-color-item.active {
  border-color: #00d992;
  box-shadow: 0 0 12rpx rgba(0, 217, 146, 0.3);
}

.bg-check {
  font-size: 28rpx;
  color: #00d992;
}

.pattern-list {
  display: flex;
  gap: 16rpx;
}

.pattern-item {
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 22rpx;
  color: #8b949e;
  transition: all 0.15s;
}

.pattern-item.active {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
}

/* ===== 妯℃澘闈㈡澘 ===== */
.template-tabs {
  white-space: nowrap;
  padding: 16rpx 32rpx 0;
  border-bottom: 1rpx solid #3d3a39;
}

.tab-list {
  display: flex;
  gap: 8rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
  border-radius: 12rpx 12rpx 0 0;
  font-size: 22rpx;
  color: #8b949e;
  transition: all 0.15s;
}

.tab-item.active {
  background: rgba(0, 217, 146, 0.1);
  color: #00d992;
  font-weight: 600;
}

.template-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 0;
}

.template-card {
  width: calc(33.33% - 14rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.template-hover .template-preview {
  border-color: #00d992;
}

.template-preview {
  width: 100%;
  aspect-ratio: 3/4;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #3d3a39;
  transition: all 0.15s;
}

.template-name {
  font-size: 20rpx;
  color: #8b949e;
  text-align: center;
}

/* ===== 椤甸潰瀵艰埅灏忓渾鐐?===== */
.page-dots-bar {
  padding: 8rpx 0;
  background: #101010;
  border-top: 1rpx solid #3d3a39;
}

.dots-scroll {
  white-space: nowrap;
}

.dots-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 4rpx 32rpx;
}

.page-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #8b949e;
  font-weight: 600;
  flex-shrink: 0;
  transition: all 0.15s;
}

.page-dot.active {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
  box-shadow: 0 0 12rpx rgba(0, 217, 146, 0.3);
}

.page-dot:active {
  transform: scale(0.9);
}

.add-dot {
  border-style: dashed;
  color: #00d992;
  border-color: #00d992;
  background: transparent;
}

/* ===== 2026 缂栬緫鍣ㄧ晫闈㈤噸鏁达細绾歌川鐢诲竷 + 绾挎潯宸ュ叿 ===== */
.editor-page {
  background: #f1eee6;
  color: #202124;
}

.top-bar {
  min-height: 88rpx;
  padding: 14rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid rgba(31, 35, 40, 0.1);
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 40, 0.08);
}

.top-left {
  min-width: 0;
}

.top-right {
  align-items: center;
  gap: 8rpx;
}

.page-name {
  max-width: 190rpx;
  color: #202124;
}

.page-hint {
  margin-top: 4rpx;
  color: #697077;
  font-size: 20rpx;
  letter-spacing: 0;
}

.icon-btn,
.mode-toggle,
.panel-close {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.14);
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 40, 0.08);
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
}

.icon-btn.disabled {
  opacity: 0.32;
}

.export-btn,
.mode-toggle.active {
  background: #202124;
  border-color: #202124;
}

.mode-toggle.active text {
  color: #ffffff;
}

.mode-toggle {
  gap: 8rpx;
  min-width: 116rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #202124;
}

.canvas-wrapper {
  padding: 28rpx 18rpx;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.34) 1rpx, transparent 1rpx) 0 0 / 36rpx 36rpx,
    linear-gradient(0deg, rgba(255,255,255,0.34) 1rpx, transparent 1rpx) 0 0 / 36rpx 36rpx,
    #e5ded1;
  perspective: 1400rpx;
}

.page-shell {
  position: relative;
  padding: 12rpx;
  border-radius: 24rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(80, 64, 42, 0.16);
  box-shadow:
    0 24rpx 50rpx rgba(84, 69, 45, 0.18),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.82);
  transform-origin: center left;
  transform-style: preserve-3d;
}

.flip-layer {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  z-index: 5;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fffaf0;
  box-shadow:
    0 18rpx 42rpx rgba(0, 0, 0, 0.28),
    inset 0 0 0 1rpx rgba(80, 64, 42, 0.14);
  transition: transform 340ms cubic-bezier(0.18, 0.8, 0.22, 1), box-shadow 340ms ease;
  backface-visibility: hidden;
  transform-style: preserve-3d;
  pointer-events: none;
}

.flip-layer.dragging {
  transition: none;
}

.flip-layer.prev {
  transform-origin: right center;
}

.flip-layer.next {
  transform-origin: left center;
}

.flip-paper-grain {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 18% 12%, rgba(80,64,42,0.08) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 72% 58%, rgba(80,64,42,0.06) 0 1rpx, transparent 2rpx),
    #fffaf0;
  background-size: 44rpx 44rpx, 58rpx 58rpx, auto;
}

.flip-paper-lines {
  position: absolute;
  inset: 0;
  opacity: 0.32;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 34rpx,
    rgba(80, 64, 42, 0.16) 35rpx
  );
}

.flip-inner-shadow,
.flip-edge-shadow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 46%;
  pointer-events: none;
}

.flip-layer.next .flip-inner-shadow {
  right: 0;
  background: linear-gradient(to left, rgba(0,0,0,0.28), rgba(0,0,0,0));
}

.flip-layer.prev .flip-inner-shadow {
  left: 0;
  background: linear-gradient(to right, rgba(0,0,0,0.28), rgba(0,0,0,0));
}

.flip-layer.next .flip-edge-shadow {
  left: 0;
  width: 18rpx;
  background: linear-gradient(to right, rgba(0,0,0,0.34), rgba(0,0,0,0));
}

.flip-layer.prev .flip-edge-shadow {
  right: 0;
  width: 18rpx;
  background: linear-gradient(to left, rgba(0,0,0,0.34), rgba(0,0,0,0));
}

.preview-mode .page-shell {
  box-shadow:
    0 34rpx 70rpx rgba(84, 69, 45, 0.24),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.92);
}

.page-shell.flip-next {
  animation: pageFlipNext 280ms ease both;
}

.page-shell.flip-prev {
  animation: pageFlipPrev 280ms ease both;
}

@keyframes pageFlipNext {
  0% { transform: rotateY(0deg) translateX(0); }
  55% { transform: rotateY(-18deg) translateX(-16rpx); }
  100% { transform: rotateY(0deg) translateX(0); }
}

@keyframes pageFlipPrev {
  0% { transform: rotateY(0deg) translateX(0); }
  55% { transform: rotateY(18deg) translateX(16rpx); }
  100% { transform: rotateY(0deg) translateX(0); }
}

