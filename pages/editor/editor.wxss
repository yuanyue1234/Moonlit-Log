  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: none;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  transition: background 0.15s, border-color 0.15s;
}

.icon-btn:active {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.24);
}

.icon-btn.disabled {
  opacity: 0.32;
}

.export-btn,
.mode-toggle.active {
  background: #ffffff;
  border-color: #ffffff;
}

.mode-toggle.active text {
  color: #101010;
}

.mode-toggle {
  gap: 8rpx;
  min-width: 116rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: background 0.15s, border-color 0.15s;
}

.canvas-wrapper {
  padding: 28rpx 18rpx;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.34) 1rpx, transparent 1rpx) 0 0 / 36rpx 36rpx,
    linear-gradient(0deg, rgba(255,255,255,0.34) 1rpx, transparent 1rpx) 0 0 / 36rpx 36rpx,
    #e5ded1;
  perspective: 1400rpx;
}

.page-shell {
  position: relative;
  padding: 12rpx;
  border-radius: 24rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(80, 64, 42, 0.16);
  box-shadow:
    0 24rpx 50rpx rgba(84, 69, 45, 0.18),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.82);
  transform-origin: center left;
  transform-style: preserve-3d;
}

.flip-layer {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  z-index: 5;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fffaf0;
  box-shadow:
    0 18rpx 42rpx rgba(0, 0, 0, 0.28),
    inset 0 0 0 1rpx rgba(80, 64, 42, 0.14);
  transition: transform 340ms cubic-bezier(0.18, 0.8, 0.22, 1), box-shadow 340ms ease;
  backface-visibility: hidden;
  transform-style: preserve-3d;
  pointer-events: none;
}

.flip-layer.dragging {
  transition: none;
}

.flip-layer.prev {
  transform-origin: right center;
}

.flip-layer.next {
  transform-origin: left center;
}

.flip-paper-grain {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 18% 12%, rgba(80,64,42,0.08) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 72% 58%, rgba(80,64,42,0.06) 0 1rpx, transparent 2rpx),
    #fffaf0;
  background-size: 44rpx 44rpx, 58rpx 58rpx, auto;
}

.flip-paper-lines {
  position: absolute;
  inset: 0;
  opacity: 0.32;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 34rpx,
    rgba(80, 64, 42, 0.16) 35rpx
  );
}

.flip-inner-shadow,
.flip-edge-shadow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 46%;
  pointer-events: none;
}

.flip-layer.next .flip-inner-shadow {
  right: 0;
  background: linear-gradient(to left, rgba(0,0,0,0.28), rgba(0,0,0,0));
}

.flip-layer.prev .flip-inner-shadow {
  left: 0;
  background: linear-gradient(to right, rgba(0,0,0,0.28), rgba(0,0,0,0));
}

.flip-layer.next .flip-edge-shadow {
  left: 0;
  width: 18rpx;
  background: linear-gradient(to right, rgba(0,0,0,0.34), rgba(0,0,0,0));
}

.flip-layer.prev .flip-edge-shadow {
  right: 0;
  width: 18rpx;
  background: linear-gradient(to left, rgba(0,0,0,0.34), rgba(0,0,0,0));
}

.preview-mode .page-shell {
  box-shadow:
    0 34rpx 70rpx rgba(84, 69, 45, 0.24),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.92);
}

.page-shell.flip-next {
  animation: pageFlipNext 280ms ease both;
}

.page-shell.flip-prev {
  animation: pageFlipPrev 280ms ease both;
}

@keyframes pageFlipNext {
  0% { transform: rotateY(0deg) translateX(0); }
  55% { transform: rotateY(-18deg) translateX(-16rpx); }
  100% { transform: rotateY(0deg) translateX(0); }
}

@keyframes pageFlipPrev {
  0% { transform: rotateY(0deg) translateX(0); }
  55% { transform: rotateY(18deg) translateX(16rpx); }
  100% { transform: rotateY(0deg) translateX(0); }
}

