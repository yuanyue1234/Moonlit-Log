/* pages/templates/templates.wxss - 暗色主题 */
.page { min-height: 100vh; background: #101010; }

.header { padding: 40rpx 32rpx 16rpx; }
.subtitle { font-size: 22rpx; color: #8b949e; margin-top: 8rpx; }

.category-scroll { white-space: nowrap; padding: 16rpx 32rpx; }
.category-list { display: flex; gap: 12rpx; }
.category-tag {
  padding: 10rpx 24rpx; border-radius: 9999rpx;
  background: #1a1a1a; border: 1rpx solid #3d3a39;
  font-size: 22rpx; color: #8b949e; flex-shrink: 0; transition: all 0.15s;
}
.category-tag.active { background: #00d992; color: #101010; border-color: #00d992; }

.template-list { height: calc(100vh - 280rpx); padding: 0 32rpx; }
.template-grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.template-card {
  width: calc(50% - 12rpx); background: #1a1a1a;
  border-radius: 16rpx; border: 1rpx solid #3d3a39;
  overflow: hidden; transition: all 0.15s;
}
.template-card:active { border-color: #00d992; }
.template-preview {
  width: 100%; aspect-ratio: 3/4; position: relative;
  display: flex; align-items: center; justify-content: center;
}
.template-paper-icon {
  position: relative;
  width: 96rpx;
  height: 124rpx;
  border: 4rpx solid rgba(255,255,255,0.76);
  border-radius: 12rpx;
  box-shadow: 0 10rpx 22rpx rgba(0,0,0,0.18);
}
.paper-line {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.68);
}
.paper-line.line-a { top: 34rpx; }
.paper-line.line-b { top: 58rpx; }
.paper-line.line-c { top: 82rpx; }
.template-info { padding: 20rpx; }
.template-name { font-size: 28rpx; font-weight: 600; color: #f2f2f2; display: block; margin-bottom: 4rpx; }
.template-desc { font-size: 20rpx; color: #8b949e; }

/* v1.1 soft line-art journal redesign */
.page {
  background:
    radial-gradient(circle at 14% 8%, rgba(234, 184, 200, 0.24), transparent 30%),
    radial-gradient(circle at 88% 20%, rgba(245, 216, 137, 0.22), transparent 25%),
    #fff7ed;
  color: #4b3930;
  font-family: 'LXGW Yozai', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-title,
.template-name {
  color: #4b3930;
}

.subtitle,
.template-desc,
.category-tag {
  color: #9a8678;
}

.category-tag,
.template-card {
  background: #fffdf8;
  border-color: #eadccf;
  box-shadow: 0 10rpx 28rpx rgba(122, 86, 58, 0.1);
}

.category-tag.active,
.template-card:active {
  background: #fdeaf1;
  border-color: #d98eaa;
  color: #c87596;
}

.template-preview {
  border-color: rgba(168, 143, 128, 0.3);
  box-shadow: 0 10rpx 22rpx rgba(122, 86, 58, 0.12);
}

.template-paper-icon {
  border-color: rgba(75, 57, 48, 0.42);
}

.paper-line {
  background: rgba(75, 57, 48, 0.42);
}

/* v1.1.0 compact template browser */
.page {
  background:
    linear-gradient(90deg, rgba(168, 143, 128, 0.08) 1rpx, transparent 1rpx) 0 0 / 34rpx 34rpx,
    linear-gradient(0deg, rgba(168, 143, 128, 0.08) 1rpx, transparent 1rpx) 0 0 / 34rpx 34rpx,
    #fff7ed;
}

.header {
  padding: 28rpx 28rpx 10rpx;
}

.subtitle {
  margin-top: 4rpx;
  font-size: 21rpx;
}

.category-scroll {
  padding: 12rpx 28rpx;
}

.category-tag {
  padding: 8rpx 20rpx;
  font-size: 21rpx;
}

.template-list {
  height: calc(100vh - 214rpx);
  padding: 0 24rpx;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.template-card {
  width: auto;
  border-radius: 14rpx;
}

.template-preview {
  aspect-ratio: 4/5;
  overflow: hidden;
  box-shadow: none;
}

.template-info {
  padding: 10rpx 10rpx 12rpx;
}

.template-name {
  margin-bottom: 2rpx;
  font-size: 21rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.template-desc {
  display: block;
  font-size: 17rpx;
  line-height: 1.25;
  min-height: 42rpx;
  overflow: hidden;
}

.template-paper-icon {
  width: 62rpx;
  height: 80rpx;
  border-width: 3rpx;
  border-radius: 10rpx;
  opacity: 0.42;
}

.paper-line {
  left: 12rpx;
  right: 12rpx;
  height: 3rpx;
}

.paper-line.line-a { top: 22rpx; }
.paper-line.line-b { top: 38rpx; }
.paper-line.line-c { top: 54rpx; }

.template-tape,
.template-title-line,
.template-photo-mark,
.template-note-line,
.template-dot {
  position: absolute;
  pointer-events: none;
}

.template-tape {
  top: 12rpx;
  left: 12rpx;
  width: 52rpx;
  height: 14rpx;
  border-radius: 5rpx;
  background: rgba(217, 142, 170, 0.42);
  transform: rotate(-7deg);
}

.template-title-line {
  top: 34rpx;
  left: 14rpx;
  right: 20rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(75, 57, 48, 0.22);
}

.template-photo-mark {
  left: 14rpx;
  right: 14rpx;
  top: 56rpx;
  height: 62rpx;
  border: 2rpx dashed rgba(168, 143, 128, 0.45);
  border-radius: 10rpx;
  background: rgba(255, 253, 248, 0.5);
}

.template-note-line {
  left: 16rpx;
  right: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(75, 57, 48, 0.16);
}

.template-note-line.line-a {
  bottom: 36rpx;
}

.template-note-line.line-b {
  bottom: 22rpx;
  right: 42rpx;
}

.template-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(168, 220, 201, 0.86);
}

.template-dot.dot-a {
  right: 14rpx;
  top: 16rpx;
}

.template-dot.dot-b {
  left: 16rpx;
  bottom: 14rpx;
  background: rgba(245, 216, 137, 0.92);
}
