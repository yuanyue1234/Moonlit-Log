.page { min-height: 100vh; background: #101010; }

.header { padding: 40rpx 32rpx 0; }
.header-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.header-actions { display: flex; gap: 12rpx; }

.category-scroll { white-space: nowrap; padding: 16rpx 32rpx; }
.category-list { display: flex; gap: 12rpx; }
.category-tag {
  padding: 10rpx 24rpx;
  border-radius: 9999rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 22rpx;
  color: #8b949e;
  flex-shrink: 0;
}
.category-tag.active { background: #00d992; color: #101010; border-color: #00d992; }

.sticker-list { height: calc(100vh - 280rpx); padding: 0 32rpx; box-sizing: border-box; }
.sticker-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sticker-card {
  width: calc(33.33% - 11rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  position: relative;
}
.sticker-card:active { border-color: #00d992; }
.sticker-image { width: 100%; height: 100%; }

.sticker-overlay {
  position: absolute;
  inset: 0;
  background: rgba(16, 16, 16, 0.72);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.edit-pill {
  min-width: 100rpx;
  text-align: center;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: #f7f3ea;
  color: #101010;
  font-size: 22rpx;
}
.edit-pill.danger { background: #ff6b6b; color: #ffffff; }

.sticker-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 9999rpx;
  font-size: 18rpx;
  color: #101010;
  background: #00d992;
}

.empty-state { padding: 140rpx 40rpx; text-align: center; }
.empty-text { color: #ffffff; font-size: 32rpx; font-weight: 600; }
.empty-hint { color: #8b949e; font-size: 24rpx; margin-top: 12rpx; }
.empty-action { width: 300rpx; margin: 32rpx auto 0; }
.safe-spacer { height: calc(120rpx + env(safe-area-inset-bottom)); }

.preview-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.86);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}
.preview-mask.show { opacity: 1; pointer-events: auto; }

.preview-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 80rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.preview-image {
  flex: 1;
  width: 100%;
  min-height: 520rpx;
  background: transparent;
  border-radius: 0;
  border: none;
}
.preview-info {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #1a1a1a;
  color: #f2f2f2;
  border: 1rpx solid #3d3a39;
}
.preview-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.preview-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }
.preview-tag {
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  border: 1rpx solid #3d3a39;
  color: #00d992;
  background: rgba(0,217,146,0.08);
  font-size: 22rpx;
}
.preview-meta { display: flex; gap: 16rpx; font-size: 24rpx; color: #8b949e; }
.meta-label { font-weight: 700; }
.preview-actions { display: flex; gap: 12rpx; margin-top: 24rpx; }
.preview-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 10rpx;
  border-radius: 12rpx;
  background: #101010;
  border: 1rpx solid #3d3a39;
  color: #f2f2f2;
  font-size: 24rpx;
}
.preview-btn.danger { color: #ff4d4f; }
.preview-close {
  position: fixed;
  top: 36rpx;
  right: 32rpx;
  padding: 12rpx 24rpx;
  border-radius: 9999rpx;
  color: #f2f2f2;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 24rpx;
}

.sticker-card.effect-white-border {
  background: #1a1a1a;
  padding: 0;
  box-sizing: border-box;
}

.sticker-card.effect-white-border .sticker-image {
  filter: drop-shadow(0 0 8rpx #ffffff) drop-shadow(0 0 12rpx rgba(255,255,255,0.8));
}

.sticker-card.effect-paper {
  background: #1a1a1a;
  padding: 0;
  box-sizing: border-box;
}

.sticker-card.effect-paper .sticker-image {
  filter: drop-shadow(0 0 10rpx #fffaf0) drop-shadow(0 10rpx 12rpx rgba(0,0,0,0.22));
}

.sticker-card.effect-shadow {
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.36);
}
