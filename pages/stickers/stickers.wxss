.page { min-height: 100vh; background: #101010; }

.header { padding: 40rpx 32rpx 0; }
.header-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.header-actions { display: flex; gap: 12rpx; }

/* 搜索框 */
.search-bar {
  position: relative;
  margin: 16rpx 32rpx 8rpx;
}
.search-input {
  width: 100%;
  height: 72rpx;
  background: #2a2a2a;
  border-radius: 36rpx;
  padding: 0 60rpx 0 32rpx;
  font-size: 26rpx;
  color: #e6edf3;
  border: 2rpx solid #3a3a3a;
  box-sizing: border-box;
}
.search-placeholder {
  color: #6e7681;
}
.search-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b949e;
  font-size: 32rpx;
}

.category-title {
  padding: 24rpx 32rpx 0;
  font-size: 22rpx;
  color: #8b949e;
}
.category-scroll { white-space: nowrap; padding: 12rpx 32rpx 16rpx; }
.category-list { display: flex; gap: 12rpx; }
.category-tag {
  padding: 10rpx 24rpx;
  border-radius: 9999rpx;
  background: #1a1a1a;
  border: 1rpx solid #3d3a39;
  font-size: 22rpx;
  color: #8b949e;
  flex-shrink: 0;
}
.category-tag.active { background: #00d992; color: #101010; border-color: #00d992; }

/* 编辑模式 — 分组标签上的小红× */
.category-tag.editable {
  position: relative;
  overflow: visible;
}
.cat-delete-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ff4d4f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.35);
}

.category-add-btn {
  background: rgba(0, 217, 146, 0.12);
  border: 1rpx solid rgba(0, 217, 146, 0.3);
  color: #00d992;
  min-width: 64rpx;
  height: 56rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
}
.category-add-btn:active {
  background: #00d992;
  color: #101010;
  border-color: #00d992;
}
.add-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.sticker-list { height: calc(100vh - 280rpx); padding: 0 24rpx; box-sizing: border-box; }

/* 瀑布流布局 */
.masonry {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}
.masonry-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.masonry-item {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  transition: outline 0.15s;
}
.masonry-item:active {
  outline: 2rpx solid #00d992;
  outline-offset: -2rpx;
}
.masonry-item.selected {
  outline: 3rpx solid #00d992;
  outline-offset: -3rpx;
}

/* 编辑模式 — 贴纸上的小红× */
.edit-delete-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ff4d4f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 14rpx rgba(255, 77, 79, 0.4);
  line-height: 1;
}
.edit-delete-badge:active {
  transform: scale(1.15);
  background: #ff7875;
}

/* 编辑按钮激活态 */
.btn-active {
  background: #00d992;
  color: #101010;
  height: 56rpx;
  font-size: var(--font-sm);
  padding: 0 28rpx;
  border-radius: 12rpx;
  font-weight: 600;
  border: none;
}

/* 快速操作按钮 */
.quick-actions {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  display: flex;
  gap: 8rpx;
  z-index: 5;
}
.quick-btn {
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 8rpx;
  border-radius: 9999rpx;
  background: rgba(16, 16, 16, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #f2f2f2;
  box-sizing: border-box;
}
.quick-btn:active {
  background: rgba(0, 217, 146, 0.8);
  border-color: #00d992;
}
.quick-btn.danger {
  color: #ff6b6b;
  border-color: rgba(255, 107, 107, 0.3);
}
.quick-btn.danger:active {
  background: rgba(255, 107, 107, 0.8);
}
.masonry-img {
  width: 100%;
  display: block;
  background: transparent;
  border-radius: 12rpx;
}

/* 卡片信息 */
.item-info {
  padding: 8rpx 12rpx 12rpx;
}
.item-group {
  display: inline-block;
  font-size: 20rpx;
  color: #00d992;
  background: rgba(0, 217, 146, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
}
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 4rpx;
}
.item-tag {
  font-size: 18rpx;
  color: #8b949e;
  background: #2a2a2a;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.masonry-overlay {
  position: absolute;
  inset: 0;
  background: rgba(16, 16, 16, 0.72);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.edit-pill {
  min-width: 100rpx;
  text-align: center;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: #f7f3ea;
  color: #101010;
  font-size: 22rpx;
}
.edit-pill.danger { background: #ff6b6b; color: #ffffff; }

.masonry-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 9999rpx;
  font-size: 18rpx;
  color: #101010;
  background: #00d992;
}

.empty-state { padding: 140rpx 40rpx; text-align: center; }
.empty-text { color: #ffffff; font-size: 32rpx; font-weight: 600; }
.empty-hint { color: #8b949e; font-size: 24rpx; margin-top: 12rpx; }
.empty-action { width: 300rpx; margin: 32rpx auto 0; }
.safe-spacer { height: calc(120rpx + env(safe-area-inset-bottom)); }

/* 贴纸效果 */
.masonry-img.effect-white-border {
  filter: drop-shadow(0 0 8rpx #ffffff) drop-shadow(0 0 12rpx rgba(255,255,255,0.8));
}
.masonry-img.effect-paper {
  filter: drop-shadow(0 0 10rpx #fffaf0) drop-shadow(0 10rpx 12rpx rgba(0,0,0,0.22));
}
.masonry-item.effect-shadow {
  filter: drop-shadow(0 12rpx 30rpx rgba(0,0,0,0.36));
}
.masonry-img.effect-photo-frame,
.preview-image.effect-photo-frame {
  padding: 12rpx 12rpx 34rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(168, 143, 128, 0.3);
  border-radius: 14rpx;
  box-shadow: 0 14rpx 30rpx rgba(122, 86, 58, 0.16);
  box-sizing: border-box;
}

/* 全屏预览 */
.preview-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.86);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}
.preview-mask.show { opacity: 1; pointer-events: auto; }

.preview-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 80rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.preview-image {
  flex: 1;
  width: 100%;
  min-height: 520rpx;
  background: transparent;
  border-radius: 0;
  border: none;
}
.preview-info {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #1a1a1a;
  color: #f2f2f2;
  border: 1rpx solid #3d3a39;
}
.preview-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.preview-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }
.preview-tag {
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  border: 1rpx solid #3d3a39;
  color: #00d992;
  background: rgba(0,217,146,0.08);
  font-size: 22rpx;
}
.preview-meta { display: flex; gap: 16rpx; font-size: 24rpx; color: #8b949e; }
.meta-label { font-weight: 700; }
.tag-editor {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}
.tag-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #3d3a39;
  background: #101010;
  color: #f2f2f2;
  font-size: 24rpx;
  box-sizing: border-box;
}
.tag-confirm {
  width: 112rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #00d992;
  color: #101010;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.preview-actions { display: flex; gap: 12rpx; margin-top: 24rpx; }
.preview-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 10rpx;
  border-radius: 12rpx;
  background: #101010;
  border: 1rpx solid #3d3a39;
  color: #f2f2f2;
  font-size: 24rpx;
}
.preview-btn.danger { color: #ff4d4f; }
.preview-btn.primary {
  background: var(--color-primary);
  color: #101010;
  border-color: var(--color-primary);
}
/* 预览弹窗分组 */
.preview-group {
  display: inline-block;
  font-size: 24rpx;
  color: #00d992;
  background: rgba(0, 217, 146, 0.12);
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.preview-close {
  margin-top: 24rpx;
  text-align: center;
  padding: 16rpx 24rpx;
  border-radius: 9999rpx;
  color: #f2f2f2;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
  align-self: center;
}

/* v1.1.0 preview stage: keep white/transparent stickers visible */
.preview-image-stage {
  flex: 1;
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx;
  border: 1rpx solid rgba(234, 220, 207, 0.75);
  border-radius: 28rpx;
  background:
    linear-gradient(45deg, rgba(168, 143, 128, 0.16) 25%, transparent 25%, transparent 75%, rgba(168, 143, 128, 0.16) 75%) 0 0 / 34rpx 34rpx,
    linear-gradient(45deg, rgba(168, 143, 128, 0.16) 25%, transparent 25%, transparent 75%, rgba(168, 143, 128, 0.16) 75%) 17rpx 17rpx / 34rpx 34rpx,
    #fffdf8;
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.78),
    0 18rpx 42rpx rgba(75, 57, 48, 0.18);
  box-sizing: border-box;
}

.preview-image-stage .preview-image {
  flex: 0 1 auto;
  width: 100%;
  height: 100%;
  min-height: 0;
  background: transparent;
}

.preview-image-stage .preview-image.effect-photo-frame {
  max-width: 92%;
  max-height: 92%;
}

/* 手账本选择弹窗 */
.book-picker {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #101010;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid #3d3a39;
  padding: 32rpx;
  max-height: 60vh;
  z-index: 1001;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f2f2f2;
  margin-bottom: 24rpx;
}
.picker-list {
  max-height: 40vh;
}
.picker-item {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #2c2c2c;
}
.picker-item:active {
  background: rgba(0, 217, 146, 0.1);
}
.picker-name {
  font-size: 28rpx;
  color: #f2f2f2;
}
.picker-close {
  margin-top: 24rpx;
  text-align: center;
  padding: 20rpx;
  color: #8b949e;
  font-size: 26rpx;
}

/* v1.1 soft line-art journal redesign */
.page {
  background:
    radial-gradient(circle at 18% 10%, rgba(234, 184, 200, 0.24), transparent 28%),
    radial-gradient(circle at 88% 18%, rgba(169, 215, 232, 0.2), transparent 24%),
    #fff7ed;
  color: #4b3930;
  font-family: 'LXGW Yozai', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-title,
.preview-title,
.picker-title,
.empty-text,
.picker-name {
  color: #4b3930;
}

.subtitle,
.category-title,
.empty-hint,
.preview-meta,
.item-tag,
.picker-close,
.search-placeholder {
  color: #9a8678;
}

.search-input,
.category-tag,
.category-add-btn,
.masonry-item,
.preview-info,
.tag-input,
.preview-btn,
.book-picker,
.picker-item {
  background: #fffdf8;
  border-color: #eadccf;
  color: #4b3930;
  box-shadow: 0 8rpx 24rpx rgba(122, 86, 58, 0.1);
}

.search-input {
  background: #fffaf2;
  border-radius: 28rpx;
}

.category-tag.active,
.category-add-btn:active,
.btn-active,
.tag-confirm,
.masonry-badge,
.preview-btn.primary {
  background: #d98eaa;
  border-color: #d98eaa;
  color: #fffdf8;
}

.category-add-btn,
.item-group,
.preview-tag,
.preview-group {
  background: #fdeaf1;
  color: #c87596;
  border-color: #eab8c8;
}

.masonry-item:active,
.masonry-item.selected {
  outline-color: #d98eaa;
}

.quick-btn {
  background: rgba(255, 253, 248, 0.9);
  border-color: #eadccf;
  color: #4b3930;
}

.quick-btn:active {
  background: #fdeaf1;
  border-color: #d98eaa;
}

.preview-mask {
  background: rgba(75, 57, 48, 0.28);
}

.edit-pill {
  background: #fffaf2;
  color: #7b665a;
}

.edit-pill.danger,
.quick-btn.danger:active {
  background: #e58a8a;
  color: #fffdf8;
}
