<view class="page">
  <view class="header">
    <view class="header-top">
      <view>
        <view class="eyebrow">COLLECTION</view>
        <view class="page-title">素材库</view>
      </view>
      <view class="header-actions">
        <view class="header-icon-btn" bindtap="onTapSort" hover-class="soft-hover" aria-label="sort">
          <image class="header-action-icon" src="/assets/icons/arrow-up-down.svg" mode="aspectFit" />
        </view>
        <view class="header-icon-btn {{isEditing ? 'active' : ''}}" bindtap="onTapEdit" hover-class="soft-hover" aria-label="edit">
          <image class="header-action-icon" src="{{isEditing ? '/assets/icons/check.svg' : '/assets/icons/edit-3.svg'}}" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="dashed-divider"></view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索标签、分组、物品..."
           placeholder-class="search-placeholder"
           value="{{searchKeyword}}"
           bindinput="onSearchInput"
           bindfocus="onFocusSearch"
           bindblur="onBlurSearch" />
    <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="onClearSearch">×</view>
  </view>

  <view class="category-title">分组</view>
  <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="{{false}}">
    <view class="category-list">
      <view class="category-tag {{activeCategory === item.key ? 'active' : ''}} {{isEditing && item.key !== 'all' && item.key !== 'favorite' ? 'editable' : ''}}" wx:for="{{categories}}" wx:key="key" bindtap="{{isEditing ? '' : 'onTapCategory'}}" data-key="{{item.key}}">
        {{item.name}}
        <view class="cat-delete-badge" wx:if="{{isEditing && item.key !== 'all' && item.key !== 'favorite'}}" catchtap="onDeleteGroup" data-name="{{item.name}}">×</view>
      </view>
      <view class="category-tag category-add-btn" bindtap="onAddGroup" wx:if="{{!isEditing}}">
        <text class="add-icon">+</text>
      </view>
    </view>
  </scroll-view>

  <scroll-view scroll-y class="sticker-list" enhanced show-scrollbar="{{false}}">
    <view class="masonry" wx:if="{{!isEmpty}}">
      <view class="masonry-col">
        <view class="masonry-item {{selectedStickerId === item.id ? 'selected' : ''}}" wx:for="{{colLeft}}" wx:key="id"
          bindtap="{{isEditing ? '' : 'onTapSticker'}}" data-id="{{item.id}}" bindlongpress="{{isEditing ? '' : 'onTapStickerPreview'}}">
          <view class="edit-delete-badge" wx:if="{{isEditing}}" catchtap="editDeleteSticker" data-id="{{item.id}}">×</view>
          <image src="{{item.src}}" mode="widthFix" class="masonry-img effect-{{item.effect || 'none'}}" />
          <view class="item-info">
            <text class="item-group" wx:if="{{item.group}}">{{item.group}}</text>
            <view class="item-tags" wx:if="{{item.tags && item.tags.length > 0}}">
              <text class="item-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" wx:if="{{index < 2}}">{{tag}}</text>
            </view>
          </view>
          <view class="quick-actions" wx:if="{{selectedStickerId === item.id && !isEditing}}" catchtap="stopPropagation">
            <view class="quick-btn" catchtap="quickToggleFavorite" data-id="{{item.id}}">
              <text>{{item.isFavorite ? '★' : '☆'}}</text>
            </view>
            <view class="quick-btn" catchtap="quickMoveGroup" data-id="{{item.id}}">
              <text>移组</text>
            </view>
            <view class="quick-btn" catchtap="quickMakeJournal" data-id="{{item.id}}">
              <text>手帐</text>
            </view>
            <view class="quick-btn danger" catchtap="quickDelete" data-id="{{item.id}}">
              <text>×</text>
            </view>
          </view>
          <view class="masonry-badge" wx:if="{{item.isFavorite && selectedStickerId !== item.id && !isEditing}}">收藏</view>
        </view>
      </view>
      <view class="masonry-col">
        <view class="masonry-item {{selectedStickerId === item.id ? 'selected' : ''}}" wx:for="{{colRight}}" wx:key="id"
          bindtap="{{isEditing ? '' : 'onTapSticker'}}" data-id="{{item.id}}" bindlongpress="{{isEditing ? '' : 'onTapStickerPreview'}}">
          <view class="edit-delete-badge" wx:if="{{isEditing}}" catchtap="editDeleteSticker" data-id="{{item.id}}">×</view>
          <image src="{{item.src}}" mode="widthFix" class="masonry-img effect-{{item.effect || 'none'}}" />
          <view class="item-info">
            <text class="item-group" wx:if="{{item.group}}">{{item.group}}</text>
            <view class="item-tags" wx:if="{{item.tags && item.tags.length > 0}}">
              <text class="item-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" wx:if="{{index < 2}}">{{tag}}</text>
            </view>
          </view>
          <view class="quick-actions" wx:if="{{selectedStickerId === item.id && !isEditing}}" catchtap="stopPropagation">
            <view class="quick-btn" catchtap="quickToggleFavorite" data-id="{{item.id}}">
              <text>{{item.isFavorite ? '★' : '☆'}}</text>
            </view>
            <view class="quick-btn" catchtap="quickMoveGroup" data-id="{{item.id}}">
              <text>移组</text>
            </view>
            <view class="quick-btn" catchtap="quickMakeJournal" data-id="{{item.id}}">
              <text>手帐</text>
            </view>
            <view class="quick-btn danger" catchtap="quickDelete" data-id="{{item.id}}">
              <text>×</text>
            </view>
          </view>
          <view class="masonry-badge" wx:if="{{item.isFavorite && selectedStickerId !== item.id && !isEditing}}">收藏</view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{isEmpty}}">
      <view class="empty-text">还没有收藏</view>
      <view class="empty-hint">上传小卡、票根或周边，开始收藏</view>
      <view class="btn btn-primary empty-action" bindtap="onTapAdd">保存收藏物</view>
    </view>
    <view class="safe-spacer"></view>
  </scroll-view>

  <view class="sticker-add-fab" bindtap="onTapAdd" wx:if="{{!isEditing}}" hover-class="soft-hover" aria-label="add sticker">
    <image class="sticker-add-icon" src="/assets/icons/plus.svg" mode="aspectFit" />
  </view>

  <!-- 手账本选择弹窗 -->
  <view class="preview-mask {{showBookPicker ? 'show' : ''}}" bindtap="closeBookPicker">
    <view class="book-picker" catchtap="stopPropagation" wx:if="{{showBookPicker}}">
      <view class="picker-title">选择手账本</view>
      <scroll-view scroll-y class="picker-list">
        <view class="picker-item" wx:for="{{books}}" wx:key="id" bindtap="onPickBook" data-book-id="{{item.id}}">
          <text class="picker-name">{{item.name}}</text>
        </view>
      </scroll-view>
      <view class="picker-close" bindtap="closeBookPicker">取消</view>
    </view>
  </view>

  <!-- 贴纸预览 - 全屏样式 -->
  <view class="preview-mask {{showPreview ? 'show' : ''}}" bindtap="closePreview">
    <view class="preview-container" catchtap="stopPropagation" wx:if="{{showPreview && previewSticker}}">
      <view class="preview-image-stage">
        <image src="{{previewSticker.src}}" mode="aspectFit" class="preview-image effect-{{previewSticker.effect || 'none'}}" lazy-load="{{false}}" show-menu-by-longpress="{{false}}" />
      </view>

      <!-- 关闭按钮 - 在信息栏上方 -->
      <view class="preview-close" bindtap="closePreview">关闭</view>

      <view class="preview-info">
        <view class="preview-title">素材详情</view>
        <view class="preview-group" wx:if="{{previewSticker.group}}">{{previewSticker.group}}</view>
        <view class="preview-tags" wx:if="{{previewSticker.tags && previewSticker.tags.length > 0}}">
          <view class="preview-tag" wx:for="{{previewSticker.tags}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="preview-meta">
          <text class="meta-label">来源</text>
          <text class="meta-value">{{previewSticker.source === 'ai_extract' ? 'AI 提取' : '用户上传'}}</text>
        </view>
        <view class="tag-editor" wx:if="{{showTagEditor}}">
          <input class="tag-input" value="{{previewTagInput}}" placeholder="输入新标签" bindinput="onPreviewTagInput" confirm-type="done" bindconfirm="confirmPreviewAddTag" />
          <view class="tag-confirm" bindtap="confirmPreviewAddTag">确定</view>
        </view>
        <view class="preview-actions">
          <view class="preview-btn" bindtap="previewToggleFavorite">{{previewSticker.isFavorite ? '取消收藏' : '收藏'}}</view>
          <view class="preview-btn" bindtap="previewAddTag">添加标签</view>
          <view class="preview-btn primary" bindtap="previewMakeJournal">做成手帐</view>
          <view class="preview-btn danger" bindtap="previewDelete">删除</view>
        </view>
      </view>
    </view>
  </view>
</view>
