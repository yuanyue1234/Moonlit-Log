<view class="page">
  <view class="header">
    <view class="header-top">
      <view>
        <view class="eyebrow">STICKER LIBRARY</view>
        <view class="page-title">我的贴纸</view>
      </view>
      <view class="header-actions">
        <view class="btn btn-small btn-secondary" bindtap="onTapEdit">{{isEditing ? '完成' : '编辑'}}</view>
        <view class="btn btn-small btn-primary" bindtap="onTapAdd">添加</view>
      </view>
    </view>
    <view class="dashed-divider"></view>
  </view>

  <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="{{false}}">
    <view class="category-list">
      <view class="category-tag {{activeCategory === item.key ? 'active' : ''}}" wx:for="{{categories}}" wx:key="key" bindtap="onTapCategory" data-key="{{item.key}}">
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <scroll-view scroll-y class="sticker-list" enhanced show-scrollbar="{{false}}">
    <view class="sticker-grid" wx:if="{{!isEmpty}}">
      <view class="sticker-card effect-{{item.effect || 'none'}}" wx:for="{{filteredStickers}}" wx:key="id" bindtap="onTapSticker" data-id="{{item.id}}">
        <image src="{{item.src}}" mode="aspectFit" class="sticker-image" />
        <view class="sticker-overlay" wx:if="{{isEditing}}">
          <view class="edit-pill" catchtap="toggleFavorite" data-id="{{item.id}}">{{item.isFavorite ? '已收藏' : '收藏'}}</view>
          <view class="edit-pill danger" catchtap="onTapDelete" data-id="{{item.id}}">删除</view>
        </view>
        <view class="sticker-badge" wx:if="{{item.isFavorite && !isEditing}}">收藏</view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{isEmpty}}">
      <view class="empty-text">还没有贴纸</view>
      <view class="empty-hint">从相册添加，或到“提取”页生成去背景贴纸。</view>
      <view class="btn btn-primary empty-action" bindtap="onTapAdd">添加贴纸</view>
    </view>
    <view class="safe-spacer"></view>
  </scroll-view>

  <view class="preview-mask {{showPreview ? 'show' : ''}}" bindtap="closePreview">
    <view class="preview-container" catchtap="stopPropagation" wx:if="{{previewSticker}}">
      <image src="{{previewSticker.src}}" mode="aspectFit" class="preview-image effect-{{previewSticker.effect || 'none'}}" />

      <view class="preview-info">
        <view class="preview-title">贴纸详情</view>
        <view class="preview-tags" wx:if="{{previewSticker.tags && previewSticker.tags.length > 0}}">
          <view class="preview-tag" wx:for="{{previewSticker.tags}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="preview-meta">
          <text class="meta-label">来源</text>
          <text class="meta-value">{{previewSticker.source === 'ai_extract' ? 'AI 提取' : '用户上传'}}</text>
        </view>
        <view class="preview-actions">
          <view class="preview-btn" bindtap="previewToggleFavorite">{{previewSticker.isFavorite ? '取消收藏' : '收藏'}}</view>
          <view class="preview-btn" bindtap="previewCopyTags">复制标签</view>
          <view class="preview-btn danger" bindtap="previewDelete">删除</view>
        </view>
      </view>

      <view class="preview-close" bindtap="closePreview">关闭</view>
    </view>
  </view>
</view>
