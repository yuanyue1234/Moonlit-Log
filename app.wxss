/* app.wxss - 柔和线条手帐主题 */

/* CSS 变量 - 暗色主题 */
page {
  /* Brand & Accent */
  --color-primary: #D98EAA;
  --color-primary-soft: #EAB8C8;
  --color-primary-deep: #B96E8B;
  --color-primary-glow: rgba(217, 142, 170, 0.18);
  --color-mint: #A8DCC9;
  --color-sky: #A9D7E8;
  --color-butter: #F5D889;

  /* Surface */
  --color-canvas: #FFF7ED;
  --color-canvas-soft: #FFFDF8;
  --color-hairline: #E7D8CB;
  --color-hairline-soft: #D5BFAF;
  --color-line: #A88F80;

  /* Text */
  --color-ink: #4B3930;
  --color-ink-strong: #2F211C;
  --color-body: #7B665A;
  --color-mute: #9A8678;

  /* Semantic */
  --color-success: #7BBFA6;
  --color-warning: #E5B75F;
  --color-danger: #E58A8A;

  /* Legacy compat */
  --color-bg: #FFF7ED;
  --color-bg-card: #FFFDF8;
  --color-text: #4B3930;
  --color-text-light: #7B665A;
  --color-text-muted: #9A8678;
  --color-border: #E7D8CB;
  --color-shadow: rgba(122, 86, 58, 0.14);

  /* Typography */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;
  --font-title: 52rpx;

  /* Shapes */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  font-family: 'LXGW Yozai', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: var(--color-canvas);
  color: var(--color-ink);
  font-size: var(--font-md);
  line-height: 1.65;
}

/* 通用类 */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-canvas-soft);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  border: 2rpx solid var(--color-hairline);
  box-shadow: 0 12rpx 32rpx var(--color-shadow);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-weight: 600;
  transition: all 0.2s ease;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--color-primary);
  color: #fffdf8;
  height: 88rpx;
  font-size: var(--font-lg);
  box-shadow: 0 0 20rpx var(--color-primary-glow);
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-secondary {
  background: transparent;
  color: var(--color-ink);
  height: 76rpx;
  font-size: var(--font-md);
  border: 1rpx solid var(--color-hairline);
}

.btn-secondary:active {
  background: var(--color-canvas-soft);
  border-color: var(--color-primary-soft);
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary-soft);
  height: 76rpx;
  font-size: var(--font-md);
  border: 1rpx dashed var(--color-hairline);
}

.btn-small {
  height: 56rpx;
  font-size: var(--font-sm);
  padding: 0 28rpx;
}

.btn-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  background: var(--color-canvas-soft);
  border: 1rpx solid var(--color-hairline);
  padding: 0;
}

.btn-icon:active {
  border-color: var(--color-primary);
  box-shadow: 0 0 12rpx var(--color-primary-glow);
}

/* 标题样式 */
.page-title {
  font-size: var(--font-title);
  font-weight: 400;
  color: var(--color-ink-strong);
  letter-spacing: -1rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: var(--font-sm);
  color: var(--color-mute);
}

/* Eyebrow 标签 - Voltagent 风格 */
.eyebrow {
  font-size: 22rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: var(--color-primary);
  margin-bottom: 12rpx;
  display: block;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
  font-size: var(--font-xs);
  background: var(--color-canvas-soft);
  color: var(--color-primary-soft);
  border: 1rpx solid var(--color-hairline);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: var(--font-md);
  color: var(--color-mute);
  text-align: center;
  margin-bottom: 40rpx;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 8rpx var(--color-primary-glow); }
  50% { box-shadow: 0 0 24rpx var(--color-primary-glow); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes flipIn {
  from { transform: perspective(1200rpx) rotateY(-90deg); opacity: 0; }
  to { transform: perspective(1200rpx) rotateY(0); opacity: 1; }
}

.anim-fade-in {
  animation: fadeIn 0.3s ease forwards;
}

.anim-glow {
  animation: glow 2s ease-in-out infinite;
}

.anim-float {
  animation: float 3s ease-in-out infinite;
}

.anim-flip {
  animation: flipIn 0.5s ease forwards;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 分割线 - Voltagent 虚线风格 */
.dashed-divider {
  border: none;
  border-top: 2rpx dashed rgba(168, 143, 128, 0.35);
  margin: 32rpx 0;
}

/* Code inline chip 风格 */
.code-chip {
  display: inline-block;
  background: var(--color-canvas-soft);
  color: var(--color-ink);
  font-family: 'LXGW Yozai', 'PingFang SC', sans-serif;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs);
  border: 1rpx solid var(--color-hairline);
}
